<script>
  if (!customElements.get('ssh-pdp')) {
    customElements.define('ssh-pdp', class extends HTMLElement {
      connectedCallback() {
        this.main = this.querySelector('.ssh-pdp__img');
        this.stage = this.querySelector('.ssh-pdp__stage');
        this.fit();
        if (document.fonts) document.fonts.ready.then(() => this.fit());
        window.addEventListener('resize', () => this.fit(), { passive: true });
        this.querySelectorAll('.ssh-pdp__th').forEach((t) => t.addEventListener('click', () => this.show(t)));
        const qi = this.querySelector('[data-qty-input]');
        this.querySelectorAll('[data-qty]').forEach((b) => b.addEventListener('click', () => {
          qi.value = Math.max(1, (parseInt(qi.value, 10) || 1) + Number(b.dataset.qty));
        }));
        this.addEventListener('change', (e) => {
          if (e.target.name === 'ssh-pdp-size') this.pick(e.target);
          if (e.target.matches('[data-set]')) this.setToggle(e.target);
        });
        this.bar();
      }
      fit() {
        const h = this.querySelector('.ssh-pdp__h1');
        if (!h) return;
        h.style.fontSize = '';
        let s = parseFloat(getComputedStyle(h).fontSize), guard = 40;
        while (h.scrollWidth > h.clientWidth + 1 && s > 32 && guard--) { s -= 2; h.style.fontSize = s + 'px'; }
      }
      show(t) {
        const vid = this.stage && this.stage.querySelector('video');
        if (t.hasAttribute('data-vid')) {
          if (!vid) {
            const tpl = this.stage.querySelector('template[data-video]');
            if (tpl) { this.stage.appendChild(tpl.content.cloneNode(true)); const v = this.stage.querySelector('video'); if (v) { v.muted = true; v.play().catch(() => {}); } }
          } else { vid.hidden = false; vid.play().catch(() => {}); }
          if (this.main) this.main.hidden = true;
        } else {
          if (vid) { vid.pause(); vid.hidden = true; }
          if (this.main) { this.main.hidden = false; this.main.srcset = t.dataset.srcset; this.main.src = t.dataset.src; this.main.alt = t.dataset.alt; }
        }
        this.querySelectorAll('.ssh-pdp__th').forEach((x) => x.setAttribute('aria-pressed', x === t ? 'true' : 'false'));
      }
      label(txt) {
        this.querySelector('[data-label]').textContent = txt;
        const bl = this.querySelector('[data-bar-label]'); if (bl) bl.textContent = txt;
      }
      price(p, base) {
        this.querySelector('[data-price]').textContent = p;
        this.querySelector('[data-unit]').textContent = base;
        const bp = this.querySelector('[data-bar-price]'); if (bp) bp.textContent = p;
      }
      pick(r) {
        const set = this.querySelector('[data-set]');
        if (set && set.checked && r.dataset.first !== 'true') set.checked = false;
        this.querySelector('[data-id]').value = r.value;
        this.price(r.dataset.price, r.dataset.unit);
        const ok = r.dataset.ok === 'true';
        this.querySelector('[data-add]').disabled = !ok;
        const bb = this.querySelector('[data-bar-btn]'); if (bb) bb.disabled = !ok;
        this.label(ok ? 'In den Warenkorb' : 'Ausverkauft');
        const u = new URL(location.href); u.searchParams.set('variant', r.value);
        history.replaceState(history.state, '', u.toString());
      }
      setToggle(cb) {
        const first = this.querySelector('input[name="ssh-pdp-size"][data-first="true"]');
        if (cb.checked) {
          if (first && !first.checked) { first.checked = true; }
          this.querySelector('[data-id]').value = cb.value;
          this.price(cb.dataset.price, cb.dataset.base);
          this.querySelector('[data-add]').disabled = false;
          const bb = this.querySelector('[data-bar-btn]'); if (bb) bb.disabled = false;
          this.label('Set in den Warenkorb');
        } else {
          const r = this.querySelector('input[name="ssh-pdp-size"]:checked');
          if (r) this.pick(r); else this.label('In den Warenkorb');
        }
      }
      bar() {
        const bar = this.querySelector('[data-bar]'), buy = this.querySelector('[data-buy]');
        if (!bar || !buy) return;
        const btn = bar.querySelector('[data-bar-btn]');
        let last = null;
        const upd = () => {
          const r = buy.getBoundingClientRect(), end = this.querySelector('.ssh-pdp__others') || this;
          const on = r.bottom < 0 && end.getBoundingClientRect().bottom > window.innerHeight * 0.6;
          if (on === last) return;
          last = on;
          bar.classList.toggle('is-on', on);
          bar.setAttribute('aria-hidden', on ? 'false' : 'true');
          if (btn) btn.tabIndex = on ? 0 : -1;
        };
        document.addEventListener('scroll', upd, { passive: true, capture: true });
        window.addEventListener('resize', upd, { passive: true });
        upd();
      }
    });
  }
</script>
<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';
  const root = document.getElementById('SshPdp-{{ section.id }}');
  const form = root && root.querySelector('form.ssh-pdp__form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-add]'), label = btn.querySelector('[data-label]'), err = form.querySelector('[data-error]');
      const barLabel = root.querySelector('[data-bar-label]');
      const say = (t) => { label.textContent = t; if (barLabel) barLabel.textContent = t; };
      if (btn.disabled) return;
      const idle = label.textContent;
      btn.disabled = true; err.hidden = true; say('Wird hinzugefügt');
      const fd = new FormData(form);
      fd.delete('ssh-pdp-size');
      const ids = Array.from(document.querySelectorAll('cart-items-component')).map((el) => el.dataset.sectionId).filter(Boolean);
      if (ids.length) fd.append('sections', ids.join(','));
      const qty = Number(fd.get('quantity')) || 1;
      let deferred = null;
      try {
        deferred = CartLinesUpdateEvent.createPromise();
        form.dispatchEvent(new CartLinesUpdateEvent({ action: 'add', context: 'product', lines: [{ merchandiseId: String(fd.get('id')), quantity: qty }], promise: deferred.promise }));
      } catch (x) { deferred = null; }
      const routes = (window.Theme && window.Theme.routes) || {};
      let added = false;
      try {
        const res = await fetch(routes.cart_add_url || '/cart/add', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/javascript' } });
        const data = await res.json();
        added = !data.status;
        const cart = await fetch((routes.cart_url || '/cart') + '.json', { headers: { Accept: 'application/json' } }).then((r) => r.json());
        if (data.status) {
          err.textContent = data.description || data.message || 'Das hat leider nicht geklappt.'; err.hidden = false;
          form.dispatchEvent(new CartErrorEvent({ error: data.message || 'Add to cart failed', code: 'INVALID', detail: { description: data.description } }));
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: true, items: cart.items, source: 'ssh-pdp', sourceId: form.id, itemCount: qty, productId: '{{ product.id }}' } });
          say(idle);
        } else {
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: false, items: cart.items, source: 'ssh-pdp', sourceId: form.id, itemCount: qty, productId: '{{ product.id }}', sections: data.sections } });
          if (!deferred) { location.href = routes.cart_url || '/cart'; return; }
          if (window.sshBubbleFly) window.sshBubbleFly(e.submitter ? e.submitter : btn, root.dataset.bubble, getComputedStyle(root).getPropertyValue('--btn'));
          say('Hinzugefügt');
          setTimeout(() => { say(idle); }, 1800);
        }
      } catch (x) {
        if (deferred && deferred.reject) deferred.reject(x);
        if (added) { location.href = routes.cart_url || '/cart'; } else { form.submit(); }
        return;
      }
      btn.disabled = false;
    });
  }
</script>

