{%- comment -%}
  Soapsister Produktseite nach Design "PDP 5: Eine Flaeche, klare Zonen" (25.11.2026).
  Pro Sorte ein Block (Farben, Duft, Galerie, INCI, Set). Die Section sucht den Block zum aktuellen Produkt,
  die uebrigen Bloecke erscheinen unten als "Die anderen Duefte". Kaufbereich in einer farbigen Flaeche mit
  Vorteilen, Groessenkarten, Duft-Umschalter und Set-Option. Beim Scrollen erscheint unten eine Kaufleiste.
  In den Warenkorb nutzt die Horizon-Events, damit sich der Warenkorb-Drawer oeffnet.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
<script src="{{ 'ssh-bubble-fly.js' | asset_url }}" defer></script>
{%- assign st = section.settings -%}
{%- assign cur = nil -%}
{%- for b in section.blocks -%}{%- if b.settings.product.id == product.id -%}{%- assign cur = b -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- assign c = cur.settings -%}
{%- assign ink = c.ink | default: '#751F65' -%}
{%- assign ink2 = c.ink_soft | default: '#1D1D1B' -%}
{%- assign btn = c.button | default: ink -%}
{%- assign tint = c.tint | default: '#F6E2EE' -%}
{%- assign name = c.name | default: product.title -%}
{%- assign sel = product.selected_or_first_available_variant -%}
{%- assign fid = 'SshPdpForm-' | append: section.id -%}
<ssh-pdp class="ss-scope ssh-pdp" id="SshPdp-{{ section.id }}" data-bubble="{{ 'soapsister-seifenblase-rosa.png' | file_url }}" style="--ink:{{ ink }};--ink2:{{ ink2 }};--btn:{{ btn }};--tint:{{ tint }};--head:{{ c.heading_color | default: ink }}">
  <nav class="ssh-pdp__crumbs" aria-label="Brotkrümel"><a href="{{ st.crumb_link | default: '/collections/duschmousse' }}">{{ st.crumb_label | escape }}</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ name | escape }}</span></nav>

  <section class="ssh-pdp__main">
    <div class="ssh-pdp__gallery">
      {%- liquid
        assign main = nil
        assign count = 0
        for i in (1..5)
          assign key = 'gallery_' | append: i
          if c[key] != blank
            if main == nil
              assign main = c[key]
            endif
            assign count = count | plus: 1
          endif
        endfor
        assign use_media = false
        if count == 0
          assign use_media = true
          assign main = product.featured_image
          assign count = product.images.size
        endif
        assign total = count
        if st.video != blank
          assign total = total | plus: 1
        endif
        assign cols = total
        if cols > 6
          assign cols = 6
        endif
      -%}
      <div class="ssh-pdp__stage">
        {%- if main != blank -%}
          {{ main | image_url: width: 1600 | image_tag: class: 'ssh-pdp__img', alt: main.alt | default: name, sizes: '(max-width: 989px) 100vw, 50vw', widths: '600, 900, 1200, 1600', fetchpriority: 'high' }}
        {%- endif -%}
        {%- if st.video != blank -%}
          <template data-video>{{ st.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ssh-pdp__vid', image_size: '1600x' }}</template>
        {%- endif -%}
      </div>
      {%- if total > 1 -%}
        <div class="ssh-pdp__thumbs" style="grid-template-columns:repeat({{ cols }},minmax(0,1fr))">
          {%- assign n = 0 -%}
          {%- if use_media -%}
            {%- for im in product.images -%}
              {%- assign n = n | plus: 1 -%}
              {%- render 'ssh-pdp-thumb', im: im, n: n, name: name -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..5) -%}
              {%- assign key = 'gallery_' | append: i -%}
              {%- if c[key] == blank -%}{%- continue -%}{%- endif -%}
              {%- assign n = n | plus: 1 -%}
              {%- render 'ssh-pdp-thumb', im: c[key], n: n, name: name -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if st.video != blank -%}
            <button type="button" class="ssh-pdp__th ssh-pdp__th--vid" aria-label="Video zeigen" aria-pressed="false" data-vid>
              {%- if st.video.preview_image -%}{{ st.video.preview_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', sizes: '120px', widths: '120, 240' }}{%- endif -%}
              <span class="ssh-pdp__play" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"/></svg></span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ssh-pdp__info">
      <div class="ssh-pdp__card">
        <div>
          <h1 class="ssh-pdp__h1">{{ name | escape }}</h1>
          <p class="ssh-pdp__sub">{{ st.kind | escape }}{% if c.scent != blank %} · duftet nach {{ c.scent | escape }}{% endif %}</p>
        </div>

        {%- if st.usps != blank -%}
          {%- assign usps = st.usps | split: '|' -%}
          <ul class="ssh-pdp__usps">
            {%- for u in usps -%}
              <li><span class="ssh-pdp__chk" aria-hidden="true" style="--rot:{{ forloop.index0 | times: 90 }}deg"><img src="{{ 'soapsister-seifenblase-rosa.png' | file_url }}" alt="" width="28" height="28" loading="lazy"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>{{ u | strip | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="ssh-pdp__pricerow">
          <div class="ssh-pdp__price" aria-live="polite"><span class="ssh-pdp__amount" data-price>{{ sel.price | money }}</span><span class="ssh-pdp__base"><span data-unit>{% render 'ssh-unit', v: sel %}</span> · inkl. MwSt., zzgl. Versand</span></div>
          {%- if st.nl_label != blank -%}
            <a class="ssh-pdp__nl" href="{{ st.nl_link | default: '#newsletter' }}"><span>{{ st.nl_badge | escape }}</span>{{ st.nl_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          {%- endif -%}
        </div>

        <hr class="ssh-pdp__rule">

        {%- form 'product', product, id: fid, class: 'ssh-pdp__form' -%}
          <input type="hidden" name="id" value="{{ sel.id }}" data-id>
          {%- if product.variants.size > 1 -%}
            <fieldset class="ssh-pdp__field">
              <legend class="ssh-pdp__label">Größe</legend>
              <div class="ssh-pdp__sizes">
                {%- for v in product.variants -%}
                  <label class="ssh-pdp__size">
                    <input type="radio" name="ssh-pdp-size" value="{{ v.id }}" data-price="{{ v.price | money | escape }}" data-unit="{% render 'ssh-unit', v: v %}" data-ok="{{ v.available }}" data-first="{{ forloop.first }}" {% if v.id == sel.id %}checked{% endif %}>
                    <span class="ssh-pdp__size-box">
                      <span class="ssh-pdp__size-t">{{ v.title | escape }}</span>
                      <span class="ssh-pdp__size-h">{%- if forloop.first -%}{%- if v.unit_price -%}{{ v.unit_price | money }}/{{ v.unit_price_measurement.reference_unit }} · {% endif -%}{{ st.hint_first | escape }}{%- else -%}{{ st.hint_other | escape }}{%- endif -%}</span>
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- if section.blocks.size > 1 -%}
            <div class="ssh-pdp__field">
              <span class="ssh-pdp__label" id="SshPdpDuft-{{ section.id }}">Duft</span>
              <ul class="ssh-pdp__scents" aria-labelledby="SshPdpDuft-{{ section.id }}">
                {%- for b in section.blocks -%}
                  {%- assign bp = b.settings.product -%}
                  {%- if bp == blank -%}{%- continue -%}{%- endif -%}
                  <li><a href="{{ bp.url }}" class="ssh-pdp__scent" style="--dot:{{ b.settings.dot }}" {% if bp.id == product.id %}aria-current="true"{% endif %}><span class="ssh-pdp__dot" aria-hidden="true"></span>{{ b.settings.name | default: bp.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- assign setp = c.set_product -%}
          {%- assign base_price = product.variants.first.price -%}
          {%- assign sum = base_price -%}
          {%- if c.duck != blank -%}{%- assign sum = sum | plus: c.duck.price -%}{%- endif -%}
          {%- if c.sponge != blank -%}{%- assign sum = sum | plus: c.sponge.price -%}{%- endif -%}
          {%- if setp != blank and setp.available -%}
            {%- assign save = sum | minus: setp.price -%}
            {%- assign extra = setp.price | minus: base_price -%}
            <hr class="ssh-pdp__rule">
            <label class="ssh-pdp__setopt">
              {%- if save > 0 -%}<span class="ssh-pdp__save" aria-hidden="true">Spar {{ save | money }}</span>{%- endif -%}
              <input type="checkbox" data-set value="{{ setp.selected_or_first_available_variant.id }}" data-price="{{ setp.price | money | escape }}" data-base="Feelgood Set{% if save > 0 %} statt {{ sum | money | escape }}{% endif %}">
              <span class="ssh-pdp__setbox" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
              <span class="ssh-pdp__setimgs" aria-hidden="true">
                {%- if c.duck.featured_image -%}{{ c.duck.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', height: 52 }}{%- endif -%}
                {%- if c.sponge.featured_image -%}{{ c.sponge.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', height: 50 }}{%- endif -%}
              </span>
              <span class="ssh-pdp__settext"><b>{{ st.set_opt_title | escape }}</b><span>+ {{ c.set_items | default: 'Netzschwamm und Badeente' | escape }}{% if save > 0 %} · du sparst {{ save | money }}{% endif %}</span></span>
              <span class="ssh-pdp__setplus">+ {{ extra | money }}</span>
            </label>
          {%- endif -%}

          <div class="ssh-pdp__buy" data-buy>
            <div class="ssh-pdp__qty">
              <button type="button" data-qty="-1" aria-label="Weniger">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Menge" data-qty-input>
              <button type="button" data-qty="1" aria-label="Mehr">+</button>
            </div>
            <button type="submit" class="ssh-pdp__add" data-add {% unless sel.available %}disabled{% endunless %}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
              <span data-label>{% if sel.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
            </button>
          </div>
          <p class="ssh-pdp__error" role="alert" hidden data-error></p>
        {%- endform -%}
      </div>

      <div class="ssh-pdp__acc">
        <details>
          <summary>Beschreibung<span aria-hidden="true">+</span></summary>
          <div class="ssh-pdp__acc-body">{%- if c.description != blank -%}{{ c.description }}{%- else -%}<p>{{ st.desc_lead | escape }}{% if c.scent != blank %} Duftet nach {{ c.scent | escape }}.{% endif %} {{ st.desc_tail | escape }}</p>{%- endif -%}</div>
        </details>
        {%- if st.usage != blank -%}
          <details>
            <summary>Anwendung<span aria-hidden="true">+</span></summary>
            <div class="ssh-pdp__acc-body">{{ st.usage }}</div>
          </details>
        {%- endif -%}
        {%- if c.inci != blank -%}
          <details>
            <summary>Inhaltsstoffe<span aria-hidden="true">+</span></summary>
            <div class="ssh-pdp__acc-body"><p>{{ c.inci | escape }}</p></div>
          </details>
        {%- endif -%}
        {%- if st.shipping != blank -%}
          <details>
            <summary>Versand<span aria-hidden="true">+</span></summary>
            <div class="ssh-pdp__acc-body">{{ st.shipping }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </section>

  <div class="ssh-pdp__bar" data-bar aria-hidden="true">
    {%- if c.jar != blank -%}{{ c.jar | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', class: 'ssh-pdp__bar-img' }}{%- endif -%}
    <span class="ssh-pdp__bar-t">{{ name | escape }} · <span data-bar-price>{{ sel.price | money }}</span></span>
    <button type="submit" form="{{ fid }}" class="ssh-pdp__add ssh-pdp__bar-btn" tabindex="-1" data-bar-btn {% unless sel.available %}disabled{% endunless %}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span data-bar-label>{% if sel.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
    </button>
  </div>

  {%- if st.steps_heading != blank -%}
    <section class="ssh-pdp__steps" aria-labelledby="SshPdpSteps-{{ section.id }}">
      <h2 class="ssh-pdp__h2" id="SshPdpSteps-{{ section.id }}">{{ st.steps_heading | escape }}</h2>
      <ol class="ssh-pdp__steplist">
        {%- for i in (1..3) -%}
          {%- assign tk = 'step' | append: i | append: '_title' -%}
          {%- assign xk = 'step' | append: i | append: '_text' -%}
          {%- assign ik = 'step' | append: i | append: '_image' -%}
          {%- if st[tk] == blank -%}{%- continue -%}{%- endif -%}
          <li>
            {%- if st[ik] != blank -%}{{ st[ik] | image_url: width: 480 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 749px) 120px, 168px', widths: '200, 300, 400, 480', class: 'ssh-pdp__stepimg' }}{%- endif -%}
            <div><span class="ssh-pdp__steptitle">{{ st[tk] | escape }}</span><p>{{ st[xk] | escape }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </section>
  {%- endif -%}

  {%- if setp != blank -%}
    <section class="ssh-pdp__set" aria-labelledby="SshPdpSet-{{ section.id }}">
      <div class="ssh-pdp__set-in">
        <div class="ssh-pdp__set-media">
          {%- assign simg = c.set_image | default: setp.featured_image -%}
          {%- if simg != blank -%}{{ simg | image_url: width: 1200 | image_tag: class: 'ssh-pdp__set-img', alt: '', loading: 'lazy', sizes: '(max-width: 749px) 100vw, 40vw', widths: '600, 900, 1200' }}{%- endif -%}
          <span class="ssh-pdp__set-acc" aria-hidden="true">
            {%- if c.sponge.featured_image -%}{{ c.sponge.featured_image | image_url: width: 300 | image_tag: alt: '', loading: 'lazy', class: 'ssh-pdp__acc-sponge', sizes: '125px' }}{%- endif -%}
            {%- if c.duck.featured_image -%}{{ c.duck.featured_image | image_url: width: 300 | image_tag: alt: '', loading: 'lazy', class: 'ssh-pdp__acc-duck', sizes: '118px' }}{%- endif -%}
          </span>
        </div>
        <div class="ssh-pdp__set-text">
          <h2 class="ssh-pdp__h2" id="SshPdpSet-{{ section.id }}">{{ name | escape }} im Set.</h2>
          {%- if c.set_text != blank -%}<p class="ssh-pdp__set-sub">{{ c.set_text | escape }}</p>{%- endif -%}
          <p class="ssh-pdp__set-price"><b>{{ setp.price | money }}</b>{% if sum > setp.price %}<span>statt <s>{{ sum | money }}</s></span>{% endif %}</p>
          <a class="ssh-pdp__ghost" href="{{ setp.url }}">{{ st.set_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.blocks.size > 1 and st.others_heading != blank -%}
    <section class="ssh-pdp__others" aria-labelledby="SshPdpOthers-{{ section.id }}">
      <h2 class="ssh-pdp__h2" id="SshPdpOthers-{{ section.id }}">{{ st.others_heading | escape }}</h2>
      <ul class="ssh-pdp__olist">
        {%- for b in section.blocks -%}
          {%- assign bp = b.settings.product -%}
          {%- if bp == blank or bp.id == product.id -%}{%- continue -%}{%- endif -%}
          <li>
            <a class="ssh-pdp__ot" href="{{ bp.url }}" style="--oink:{{ b.settings.ink }};--circle:{{ b.settings.circle }}">
              <span class="ssh-pdp__ot-media" aria-hidden="true">
                <span class="ssh-pdp__ot-circle"></span>
                {%- if b.settings.jar != blank -%}{{ b.settings.jar | image_url: width: 600 | image_tag: alt: '', loading: 'lazy', class: 'ssh-pdp__ot-jar', sizes: '270px', widths: '300, 540, 600' }}{%- endif -%}
              </span>
              <span class="ssh-pdp__ot-name">{{ b.settings.name | default: bp.title | escape }}</span>
              <span class="ssh-pdp__ot-line">{% if b.settings.scent != blank %}Duftet nach {{ b.settings.scent | escape }} · {% endif %}ab {{ bp.price_min | money }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</ssh-pdp>

<script type="application/ld+json">{{ product | structured_data }}</script>

<style>
  .ssh-pdp{display:block;background:var(--color-background,#F1F1E9);color:#1D1D1B;padding-bottom:120px}
  .ssh-pdp a{color:inherit;text-decoration:none}
  .ssh-pdp__crumbs{padding:8px 7.4% 0;font-size:15px;letter-spacing:.06em;opacity:.75}
  .ssh-pdp__crumbs a:hover{text-decoration:underline;text-underline-offset:3px}
  .ssh-pdp__main{padding:28px 7.4% 0;display:flex;gap:72px;flex-wrap:wrap;align-items:flex-start}
  .ssh-pdp__gallery{flex:1.15 1 560px;min-width:0;display:flex;flex-direction:column;gap:14px}
  .ssh-pdp__stage{position:relative;aspect-ratio:1/1;border-radius:32px;overflow:hidden;background:var(--tint)}
  .ssh-pdp__img,.ssh-pdp__vid{width:100%;height:100%;object-fit:cover;display:block}
  .ssh-pdp__vid{position:absolute;inset:0}
  .ssh-pdp__thumbs{display:grid;gap:10px}
  .ssh-pdp__th{position:relative;padding:0;border:0;border-radius:18px;overflow:hidden;aspect-ratio:1;cursor:pointer;opacity:.65;outline:3px solid transparent;outline-offset:3px;background:var(--tint);transition:opacity .2s,outline-color .2s}
  .ssh-pdp__th img{width:100%;height:100%;object-fit:cover;display:block}
  .ssh-pdp__th:hover{opacity:1}
  .ssh-pdp__th[aria-pressed="true"]{opacity:1;outline-color:var(--ink)}
  .ssh-pdp__th:focus-visible{opacity:1;outline-color:var(--ink)}
  .ssh-pdp__play{position:absolute;left:50%;top:50%;width:36px;height:36px;margin:-18px 0 0 -18px;border-radius:50%;background:rgba(255,255,255,.92);color:var(--ink);display:grid;place-items:center}
  .ssh-pdp__info{flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:24px}
  .ssh-pdp__card{background:var(--tint);border-radius:32px;padding:40px 36px 32px;display:flex;flex-direction:column;gap:20px}
  .ssh-pdp__h1{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(72px,6.4vw,100px);line-height:.88;color:var(--head,var(--ink));white-space:nowrap;max-width:100%;overflow-wrap:normal}
  .ssh-pdp__sub{margin:10px 0 0;font-size:21px;color:var(--ink2)}
  .ssh-pdp__usps{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px}
  .ssh-pdp__usps li{display:flex;align-items:center;gap:6px;font-weight:600;font-size:15px;letter-spacing:.04em;color:var(--ink)}
  .ssh-pdp__chk{position:relative;width:28px;height:28px;display:grid;place-items:center}
  .ssh-pdp__chk img{position:absolute;inset:0;width:100%;height:100%;rotate:var(--rot)}
  .ssh-pdp__chk svg{position:relative}
  .ssh-pdp__pricerow{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:4px}
  .ssh-pdp__price{display:flex;align-items:baseline;gap:6px 14px;flex-wrap:wrap}
  .ssh-pdp__amount{font-weight:600;font-size:44px;line-height:1;color:var(--ink)}
  .ssh-pdp__base{font-size:16px;color:var(--ink2)}
  .ssh-pdp__nl{display:flex;align-items:center;gap:6px;font-size:15px;color:var(--ink)}
  .ssh-pdp .ssh-pdp__nl{color:var(--ink)}
  .ssh-pdp__nl span{background:#FFFFFF;border-radius:999px;padding:4px 10px;font-weight:600;font-size:14px}
  .ssh-pdp__nl:hover{text-decoration:underline;text-underline-offset:3px}
  .ssh-pdp__rule{border:0;height:2px;margin:4px 0;background:color-mix(in srgb,var(--ink) 12%,transparent)}
  .ssh-pdp__form{display:flex;flex-direction:column;gap:20px;margin:0}
  .ssh-pdp__field{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;min-width:0}
  .ssh-pdp__label{padding:0;font-weight:600;font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}
  .ssh-pdp__sizes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .ssh-pdp__size{position:relative;display:block}
  .ssh-pdp__size input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer;z-index:1}
  .ssh-pdp__size-box{display:block;min-height:64px;box-sizing:border-box;padding:10px 16px;border-radius:18px;background:rgba(255,255,255,.5);border:2px solid transparent;transition:background .2s,border-color .2s}
  .ssh-pdp__size input:checked + .ssh-pdp__size-box{background:#FFFFFF;border-color:var(--btn)}
  .ssh-pdp__size input:focus-visible + .ssh-pdp__size-box{outline:3px solid var(--btn);outline-offset:2px}
  .ssh-pdp__size-t{display:block;font-weight:600;font-size:19px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}
  .ssh-pdp__size-h{display:block;font-size:15px;margin-top:2px}
