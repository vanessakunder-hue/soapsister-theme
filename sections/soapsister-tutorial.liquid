{%- comment -%}
  Soapsister Tutorial: Video (oder Bild, solange es kein Video gibt) und nummerierte Schritte.
{%- endcomment -%}

<div class="section section--page-width">
  <div
    class="soapsister-tutorial"
    style="
      --tutorial-accent: {{ section.settings.accent_color }};
      --tutorial-radius: {{ section.settings.corner_radius }}px;
      padding-block-start: {{ section.settings.padding-block-start }}px;
      padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    <div class="soapsister-tutorial__media">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag: controls: true, playsinline: true, preload: 'metadata', class: 'soapsister-tutorial__video'
        }}
      {%- elsif section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'soapsister-tutorial__image'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'soapsister-tutorial__image' }}
      {%- endif -%}
    </div>

    <div class="soapsister-tutorial__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="soapsister-tutorial__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <ol class="soapsister-tutorial__steps">
        {%- for block in section.blocks -%}
          <li class="soapsister-tutorial__step" {{ block.shopify_attributes }}>
            <span class="soapsister-tutorial__number" aria-hidden="true">{{ forloop.index }}</span>
            <span>
              <strong class="soapsister-tutorial__step-title">{{ block.settings.title }}</strong>
              {{ block.settings.text }}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% stylesheet %}
  .soapsister-tutorial {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .soapsister-tutorial {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
    }
  }

  .soapsister-tutorial__media {
    overflow: hidden;
    border-radius: var(--tutorial-radius);
  }

  .soapsister-tutorial__image,
  .soapsister-tutorial__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .soapsister-tutorial__content {
    display: grid;
    gap: 20px;
  }

  .soapsister-tutorial__heading {
    margin: 0;
    font-family: var(--font-heading--family);
  }

  .soapsister-tutorial__steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soapsister-tutorial__step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 18px;
    background: rgb(255 255 255 / 0.6);
    border-radius: calc(var(--tutorial-radius) / 1.5);
  }

  .soapsister-tutorial__number {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-weight: 700;
    color: #fff;
    background: var(--tutorial-accent);
    border-radius: 50%;
  }

  .soapsister-tutorial__step-title {
    display: block;
    margin-bottom: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Soapsister Tutorial",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "So geht's: in 3 Schritten"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (wenn vorhanden)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild (solange es kein Video gibt)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Farbe der Nummern",
      "default": "#751F65"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Abrundung der Ecken",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Nehmen"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Nimm eine Fingerspitze Mousse aus dem Tiegel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soapsister Tutorial",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Nehmen",
            "text": "Nimm eine Fingerspitze Mousse aus dem Tiegel."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Aufschäumen",
            "text": "Schäum sie mit dem nassen Netzschwamm auf."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Abspülen",
            "text": "Spül den Schaum gründlich ab."
          }
        }
      ]
    }
  ]
}
{% endschema %}
