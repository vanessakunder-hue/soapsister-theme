{%- comment -%}
  Soapsister Sortenkarten: eine farbige Karte je Sorte mit Bild, Name, Duft,
  Größenauswahl (Preis und Grundpreis), Steuerhinweis und Warenkorb-Knopf.
  Jede Karte ist ein Block mit eigenem Produkt und eigenen Farben.
{%- endcomment -%}

<div class="section section--{{ section.settings.section_width }}">
  <div
    class="soapsister-sorten"
    style="
      --soapsister-sorten-gap: {{ section.settings.gap }}px;
      --soapsister-sorten-radius: {{ section.settings.corner_radius }}px;
      padding-block-start: {{ section.settings.padding-block-start }}px;
      padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="soapsister-sorten__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="soapsister-sorten__grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <article
          class="soapsister-sorte"
          style="
            --sorte-background: {{ block.settings.background_color }};
            --sorte-accent: {{ block.settings.accent_color }};
            --sorte-text: {{ block.settings.text_color }};
          "
          {{ block.shopify_attributes }}
        >
          {%- if product != blank -%}
            {%- assign sorte_image = block.settings.cutout | default: product.featured_image -%}
            <a class="soapsister-sorte__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if sorte_image -%}
                {{
                  sorte_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: sorte_image.alt
                    | default: product.title,
                    class: 'soapsister-sorte__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'soapsister-sorte__image' }}
              {%- endif -%}
            </a>

            <div class="soapsister-sorte__content">
              <h3 class="soapsister-sorte__title">
                <a href="{{ product.url }}">{{ block.settings.title | default: product.title }}</a>
              </h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="soapsister-sorte__subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}

              {%- form 'product', product, class: 'soapsister-sorte__form' -%}
                <fieldset class="soapsister-sorte__sizes">
                  <legend class="visually-hidden">Größe für {{ product.title }}</legend>
                  {%- for variant in product.variants -%}
                    <label class="soapsister-sorte__size">
                      <input
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        {% if variant == product.selected_or_first_available_variant %}
                          checked
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                      <span class="soapsister-sorte__size-name">{{ variant.title }}</span>
                      <span class="soapsister-sorte__size-price">
                        <strong>{{ variant.price | money }}</strong>
                        {%- if variant.unit_price_measurement -%}
                          ({{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement }})
                        {%- endif -%}
                        {%- unless variant.available %} · ausverkauft{% endunless -%}
                      </span>
                    </label>
                  {%- endfor -%}
                </fieldset>

                {%- if section.settings.tax_note != blank -%}
                  <p class="soapsister-sorte__tax">
                    {{ section.settings.tax_note }}
                    {%- if shop.shipping_policy.body != blank %}
                      <a href="{{ shop.shipping_policy.url }}">{{ section.settings.shipping_label }}</a>
                    {%- else %}
                      {{ section.settings.shipping_label }}
                    {%- endif -%}
                  </p>
                {%- endif -%}

                <button
                  type="submit"
                  name="add"
                  class="soapsister-sorte__button"
                  {% unless product.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if product.available -%}
                    {{ section.settings.button_label }}
                  {%- else -%}
                    Ausverkauft
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>
          {%- else -%}
            <div class="soapsister-sorte__content">
              <h3 class="soapsister-sorte__title">{{ block.settings.title | default: 'Sorte' }}</h3>
              <p class="soapsister-sorte__subtitle">Bitte im Editor ein Produkt auswählen.</p>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .soapsister-sorten {
    display: grid;
    gap: var(--soapsister-sorten-gap);
  }

  .soapsister-sorten__heading {
    margin: 0;
    font-family: var(--font-heading--family);
  }

  .soapsister-sorten__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--soapsister-sorten-gap);
  }

  @media screen and (min-width: 750px) {
    .soapsister-sorten__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .soapsister-sorte {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Verlauf von oben nach unten: oben fast weiß in der Sortenfarbe, unten satt mit der Akzentfarbe */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sorte-background) 30%, #fff) 0%,
      var(--sorte-background) 45%,
      color-mix(in srgb, var(--sorte-background) 70%, var(--sorte-accent)) 100%
    );
    color: var(--sorte-text);
    border-radius: var(--soapsister-sorten-radius);
  }

  .soapsister-sorte__media {
    display: block;
    padding: 8% 8% 0;
    margin-bottom: 24px;
  }

  .soapsister-sorte__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .soapsister-sorte__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 0 5% 5%;
  }

  .soapsister-sorte__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--sorte-accent);
  }

  .soapsister-sorte__title a {
    color: inherit;
    text-decoration: none;
  }

  .soapsister-sorte__subtitle {
    margin: 0;
    line-height: 1.5;
    min-height: 3em; /* immer Platz für zwei Zeilen, damit die Größenfelder auf einer Höhe stehen */
  }

  .soapsister-sorte__form {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
  }

  .soapsister-sorte__sizes {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .soapsister-sorte__size {
    position: relative;
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 14px 18px;
    background: rgb(255 255 255 / 0.5);
    border: 1.5px solid transparent;
    border-radius: calc(var(--soapsister-sorten-radius) / 1.5);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .soapsister-sorte__size:has(input:checked) {
    background: rgb(255 255 255 / 0.9);
    border-color: var(--sorte-accent);
  }

  .soapsister-sorte__size:has(input:focus-visible) {
    outline: 2px solid var(--sorte-accent);
    outline-offset: 2px;
  }

  .soapsister-sorte__size:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .soapsister-sorte__size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .soapsister-sorte__size-name {
    min-width: 3.5em;
    font-weight: 700;
  }

  .soapsister-sorte__tax {
    margin: 0;
    font-size: 0.8125rem;
  }

  .soapsister-sorte__tax a {
    color: inherit;
  }

  .soapsister-sorte__button {
    margin-top: auto;
    min-height: 52px;
    padding: 0 24px;
    font: inherit;
    font-weight: 700;
    color: #fff;
    background: var(--sorte-accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .soapsister-sorte__button:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .soapsister-sorte__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Soapsister Sortenkarten",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Wähle deine Sorte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text auf dem Knopf",
      "default": "In den Warenkorb"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Steuerhinweis",
      "default": "inkl. MwSt., zzgl."
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Wort für den Versand-Link",
      "default": "Versand"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breite",
      "options": [
        {
          "value": "page-width",
          "label": "Seitenbreite"
        },
        {
          "value": "full-width",
          "label": "Volle Breite"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand zwischen den Karten",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Abrundung der Ecken",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "sorte",
      "name": "Sorte",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt"
        },
        {
          "type": "image_picker",
          "id": "cutout",
          "label": "Freisteller (Produkt ohne Hintergrund)",
          "info": "Quadratisches PNG mit transparentem Hintergrund. Leer = erstes Produktbild."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name (leer = Produktname)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Untertitel",
          "default": "Duschmousse"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Hintergrundfarbe",
          "default": "#F3D2E4"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Akzentfarbe (Name und Knopf)",
          "default": "#751F65"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Textfarbe",
          "default": "#1D3F51"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soapsister Sortenkarten",
      "blocks": [
        {
          "type": "sorte",
          "settings": {
            "title": "Lollipop",
            "subtitle": "Duschmousse, duftet nach Orange und Granatapfel",
            "background_color": "#F3D2E4",
            "accent_color": "#751F65",
            "text_color": "#1D3F51"
          }
        },
        {
          "type": "sorte",
          "settings": {
            "title": "Coconut",
            "subtitle": "Duschmousse, duftet nach Kokos",
            "background_color": "#E2E0DC",
            "accent_color": "#1D3F51",
            "text_color": "#1D3F51"
          }
        },
        {
          "type": "sorte",
          "settings": {
            "title": "Marshmallow",
            "subtitle": "Duschmousse, duftet nach Buttermilch",
            "background_color": "#C2E9F8",
            "accent_color": "#1D3F51",
            "text_color": "#1D3F51"
          }
        }
      ]
    }
  ]
}
{% endschema %}
