{%- comment -%}
  Über uns A: Skin, Soul, Sisterhood (Claude Design, 26.11.2026).
  Einstieg mit Gründerin-Foto, Werte-Leiste, drei Bild-Text-Bänder (Blöcke "pillar") und ein Abschluss mit Tiegeln.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
{%- assign sid = '#SshAbout-' | append: section.id -%}
<style>
  {{ sid }}{--plum:#751F65;--ink:#1D1D1B;background:#F1F1E9;color:var(--ink);font-family:var(--ss-text)}
  {{ sid }} .ab-hero{padding:72px 7.4% 80px;display:flex;gap:80px;align-items:center}
  {{ sid }} .ab-hero__copy{flex:1 1 520px;min-width:0;display:flex;flex-direction:column;gap:24px}
  {{ sid }} .ab-h1{margin:0;font-family:var(--ss-display);font-weight:900;text-transform:uppercase;font-size:clamp(72px,10vw,156px);line-height:.9;color:var(--plum);overflow-wrap:normal;word-break:normal;hyphens:manual}
  {{ sid }} .ab-sub{margin:0;font-weight:600;font-size:24px;letter-spacing:.04em;color:var(--plum)}
  {{ sid }} .ab-intro{margin:0;font-size:21px;line-height:1.55;color:#4A1240;max-width:40ch}
  {{ sid }} .ab-hero__media{flex:0 1 470px;min-width:0;position:relative}
  {{ sid }} .ab-hero__media img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:36px;display:block}
  {{ sid }} .ab-cap{margin:0;position:absolute;left:-28px;bottom:36px;background:#fff;color:var(--ink);border-radius:999px;padding:12px 22px;font-weight:600;font-size:17px;letter-spacing:.08em;box-shadow:0 14px 30px rgba(29,29,27,.14)}
  {{ sid }} .ab-values{padding:0 7.4% 96px}
  {{ sid }} .ab-values ul{list-style:none;margin:0;padding:20px 44px;display:flex;flex-wrap:nowrap;justify-content:space-between;align-items:center;gap:14px 28px;background:var(--plum);border-radius:999px;box-shadow:0 18px 40px rgba(117,31,101,.22)}
  {{ sid }} .ab-values li{display:flex;align-items:center;gap:12px;color:#fff}
  {{ sid }} .ab-ico{width:50px;height:50px;flex:none;border-radius:50%;display:grid;place-items:center;background:rgba(246,211,230,.16);color:#FFFFFF;box-shadow:inset 0 0 0 1.5px rgba(246,211,230,.35);transition:transform .35s cubic-bezier(.3,1.6,.5,1),background-color .25s}
  {{ sid }} .ab-values li:hover .ab-ico{transform:scale(1.12) rotate(-8deg);background:rgba(246,211,230,.26)}
  {{ sid }} .ab-values strong{font-family:var(--ss-display);font-weight:900;font-size:28px;line-height:1;text-transform:uppercase;letter-spacing:.01em;white-space:nowrap}
  {{ sid }} .ab-values .ab-vt{font-size:17px;line-height:1.25;color:#F6D3E6;max-width:13ch}
  @media (max-width:1199px){ {{ sid }} .ab-values ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 32px;padding:26px 36px;border-radius:36px} {{ sid }} .ab-values .ab-vt{max-width:none} }
  {{ sid }} .ab-pillar{background:var(--bg);color:var(--tx);padding:110px 7.4%;display:flex;gap:88px;align-items:center}
  {{ sid }} .ab-pillar--rev{flex-direction:row-reverse}
  {{ sid }} .ab-pillar__copy{flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:18px}
  {{ sid }} .ab-h2{margin:0;font-family:var(--ss-display);font-weight:900;text-transform:uppercase;font-size:clamp(56px,6.4vw,100px);line-height:.9;color:var(--tx);overflow-wrap:normal;word-break:normal;hyphens:manual}
  {{ sid }} .ab-pillar .ab-sub{color:var(--tx)}
  {{ sid }} .ab-pillar__text{margin:0;font-size:20px;line-height:1.55;color:var(--tx);max-width:44ch}
  {{ sid }} .ab-pillar__media{flex:1.15 1 480px;min-width:0}
  {{ sid }} .ab-pillar__media img{width:100%;height:auto;aspect-ratio:5/4;object-fit:cover;border-radius:32px;display:block}
  {{ sid }} .ab-cta{background:#E08FBC;color:var(--plum);padding:96px 7.4%;display:flex;align-items:center;justify-content:space-between;gap:40px}
  {{ sid }} .ab-jars,{{ sid }} .ab-btn{flex:none}

  {{ sid }} .ab-cta__copy{flex:0 1 420px;min-width:300px;display:flex;flex-direction:column;gap:14px}
  {{ sid }} .ab-cta .ab-h2{color:var(--plum);font-size:clamp(56px,6vw,96px)}
  {{ sid }} .ab-cta__text{margin:0;font-size:20px;line-height:1.55;color:#4A1240;max-width:44ch}
  {{ sid }} .ab-jars{display:flex;align-items:flex-end}
  {{ sid }} .ab-jars img{height:124px;width:auto;display:block}
  {{ sid }} .ab-jars img:nth-child(2){height:158px;margin:0 -16px;position:relative;z-index:1}
  {{ sid }} .ab-btn{display:inline-flex;align-items:center;gap:12px;background:var(--plum);color:#fff;border-radius:999px;min-height:58px;padding:0 32px;font-weight:600;font-size:17px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;transition:filter .2s,transform .25s}
  {{ sid }} .ab-btn:hover{filter:brightness(1.15);transform:translateY(-2px)}
  {{ sid }} .ab-btn svg{transition:transform .25s}
  {{ sid }} .ab-btn:hover svg{transform:translateX(4px)}
  {{ sid }} .ab-btn:focus-visible{outline:3px solid var(--plum);outline-offset:4px}
  @media (max-width:989px){
    {{ sid }} .ab-hero,{{ sid }} .ab-pillar{flex-direction:column;align-items:stretch;gap:40px}
    {{ sid }} .ab-pillar{padding:72px 7.4%}
    {{ sid }} .ab-hero__media{flex:none;max-width:520px}
    {{ sid }} .ab-pillar__media,{{ sid }} .ab-pillar__copy,{{ sid }} .ab-hero__copy{flex:none}
    {{ sid }} .ab-cap{left:16px}
    {{ sid }} .ab-cta{flex-wrap:wrap}
  }
  @media (max-width:749px){
    {{ sid }} .ab-hero{padding:40px 16px 56px}
    {{ sid }} .ab-h1{font-size:clamp(56px,17vw,88px)}
    {{ sid }} .ab-sub{font-size:20px}
    {{ sid }} .ab-intro{font-size:18px}
    {{ sid }} .ab-values{padding:0 16px 64px}
    {{ sid }} .ab-values ul{flex-direction:column;align-items:flex-start;gap:16px;padding:26px 24px;border-radius:32px}
    {{ sid }} .ab-values strong{font-size:26px}
    {{ sid }} .ab-values .ab-vt{max-width:none}
    {{ sid }} .ab-pillar{padding:56px 16px}
    {{ sid }} .ab-h2{font-size:clamp(48px,14vw,72px)}
    {{ sid }} .ab-pillar__text,{{ sid }} .ab-cta__text{font-size:18px}
    {{ sid }} .ab-cta{padding:64px 16px;flex-direction:column;align-items:flex-start;gap:32px}
    {{ sid }} .ab-cta__copy{flex:none;min-width:0}
    {{ sid }} .ab-jars img{height:84px}
    {{ sid }} .ab-jars img:nth-child(2){height:106px;margin:0 -10px}
  }
  @media (prefers-reduced-motion:reduce){ {{ sid }} .ab-btn,{{ sid }} .ab-btn svg,{{ sid }} .ab-ico{transition:none} }
</style>

<div id="SshAbout-{{ section.id }}" class="ss-scope">
  <section class="ab-hero">
    <div class="ab-hero__copy">
      <h1 class="ab-h1">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- if section.settings.subline != blank -%}<p class="ab-sub">{{ section.settings.subline | escape }}</p>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="ab-intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="ab-hero__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, widths: '470, 700, 940, 1200', sizes: '(min-width: 990px) 470px, 90vw', fetchpriority: 'high', style: section.settings.image_focus }}
        {%- if section.settings.caption != blank -%}<p class="ab-cap">{{ section.settings.caption | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </section>

  {%- assign values = section.blocks | where: 'type', 'value' -%}
  {%- if values.size > 0 -%}
    <div class="ab-values">
      <ul aria-label="{{ section.settings.values_label | escape }}">
        {%- for b in values -%}
          <li {{ b.shopify_attributes }}><span class="ab-ico" aria-hidden="true"><svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {%- case b.settings.icon -%}
              {%- when 'sprout' -%}<path d="M12 21v-8"/><path d="M12 13c0-4-3-6.5-7.5-6.5 0 4.2 3 6.5 7.5 6.5z"/><path d="M12 11c0-4 3-6.5 7.5-6.5 0 4.2-3 6.5-7.5 6.5z"/>
              {%- when 'hand' -%}<path d="M12 11.6c-1.1-1.8-4-1.5-4 .8 0 1.6 2 3 4 4.4 2-1.4 4-2.8 4-4.4 0-2.3-2.9-2.6-4-.8z"/><path d="M2.5 19.5h3.2l3.6 1.5h6.2l5.6-3.6c.6-.4.7-1.3.1-1.8-.5-.4-1.2-.4-1.7 0L16 17.6"/>
              {%- when 'nodrop' -%}<path d="M12 3.5c3.2 4.1 5.2 6.8 5.2 9.6a5.2 5.2 0 0 1-10.4 0c0-2.8 2-5.5 5.2-9.6z"/><path d="M4 20L20 4"/>
              {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>
              {%- else -%}<path d="M5 19.5c0-8.5 5.5-15 15-15 0 10-6 15.5-14 15.5"/><path d="M5 19.5c3-4.5 6.5-7.5 10.5-9.5"/>
            {%- endcase -%}
          </svg></span><strong>{{ b.settings.strong | escape }}</strong><span class="ab-vt">{{ b.settings.text | escape }}</span></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- assign pillars = section.blocks | where: 'type', 'pillar' -%}
  {%- for b in pillars -%}
    <section class="ab-pillar{% cycle '', ' ab-pillar--rev' %}" style="--bg:{{ b.settings.bg }};--tx:{{ b.settings.ink }}" {{ b.shopify_attributes }}>
      <div class="ab-pillar__copy">
        <h2 class="ab-h2">{{ b.settings.title | escape }}</h2>
        {%- if b.settings.subline != blank -%}<p class="ab-sub">{{ b.settings.subline | escape }}</p>{%- endif -%}
        {%- if b.settings.text != blank -%}<p class="ab-pillar__text">{{ b.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if b.settings.image != blank -%}
        <div class="ab-pillar__media">
          {{ b.settings.image | image_url: width: 1400 | image_tag: alt: b.settings.image_alt, loading: 'lazy', widths: '480, 700, 1000, 1400', sizes: '(min-width: 990px) 48vw, 92vw', style: b.settings.focus }}
        </div>
      {%- endif -%}
    </section>
  {%- endfor -%}

  <section class="ab-cta">
    <div class="ab-cta__copy">
      <h2 class="ab-h2">{{ section.settings.cta_title | escape }}</h2>
      {%- if section.settings.cta_text != blank -%}<p class="ab-cta__text">{{ section.settings.cta_text | escape }}</p>{%- endif -%}
    </div>
    <div class="ab-jars" aria-hidden="true">
      {%- if section.settings.jar_1 != blank -%}{{ section.settings.jar_1 | image_url: width: 500 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
      {%- if section.settings.jar_2 != blank -%}{{ section.settings.jar_2 | image_url: width: 600 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
      {%- if section.settings.jar_3 != blank -%}{{ section.settings.jar_3 | image_url: width: 500 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a class="ab-btn" href="{{ section.settings.cta_link | default: '/collections/duschmousse' }}">{{ section.settings.cta_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Soapsister: Über uns",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Together\nin care." },
    { "type": "text", "id": "subline", "label": "Unterzeile", "default": "For skin, soul and sisterhood." },
    { "type": "textarea", "id": "intro", "label": "Einleitung" },
    { "type": "image_picker", "id": "image", "label": "Foto Gründerin" },
    { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
    { "type": "text", "id": "image_focus", "label": "Bildausschnitt (CSS)", "default": "object-position:50% 25%" },
    { "type": "text", "id": "caption", "label": "Bildunterschrift" },
    { "type": "text", "id": "values_label", "label": "Werte-Leiste (Screenreader)", "default": "Das steckt in Soapsister" },
    { "type": "header", "content": "Abschluss" },
    { "type": "text", "id": "cta_title", "label": "Überschrift", "default": "Lust auf Fluff?" },
    { "type": "textarea", "id": "cta_text", "label": "Text" },
    { "type": "image_picker", "id": "jar_1", "label": "Tiegel links" },
    { "type": "image_picker", "id": "jar_2", "label": "Tiegel Mitte" },
    { "type": "image_picker", "id": "jar_3", "label": "Tiegel rechts" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Zum Duschmousse" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Wert",
      "settings": [
        { "type": "text", "id": "strong", "label": "Fett", "default": "Vegan" },
        { "type": "text", "id": "text", "label": "Text", "default": "in allen drei Sorten" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Blatt" },
          { "value": "sprout", "label": "Keimling" },
          { "value": "hand", "label": "Herz in der Hand" },
          { "value": "nodrop", "label": "Tropfen durchgestrichen" },
          { "value": "heart", "label": "Herz" }
        ], "default": "leaf" }
      ]
    },
    {
      "type": "pillar",
      "name": "Band",
      "settings": [
        { "type": "text", "id": "title", "label": "Überschrift", "default": "For skin." },
        { "type": "text", "id": "subline", "label": "Unterzeile" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
        { "type": "text", "id": "focus", "label": "Bildausschnitt (CSS)", "default": "object-position:50% 50%" },
        { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#F6E2EE" },
        { "type": "color", "id": "ink", "label": "Schriftfarbe", "default": "#751F65" }
      ]
    }
  ],
  "presets": [{ "name": "Soapsister: Über uns" }]
}
{% endschema %}
