{%- comment -%}
  SOAP SISTER "Über uns" (03.11.2026): 50/50, links Überschrift, Text und runder Button, rechts bis zu drei Bilder, die
  wie Fotos in Rahmen übereinanderliegen, leicht gedreht (Kundenwunsch). Fehlt Bild 2, liegt die Wolkenszene dahinter.
  Styles stecken in der Section, Schriften und Farben aus snippets/ss-tokens.liquid.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
{%- assign sid = '#SsAbout-' | append: section.id -%}
<style>
  {{ sid }} { padding: clamp(64px, 8vw, 128px) clamp(16px, 4vw, 64px); background: var(--ss-coconut); color: var(--ss-ink); }
  {{ sid }} .ssa__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; max-width: 1320px; margin-inline: auto; }
  {{ sid }} .ssa__copy { display: grid; gap: 20px; justify-items: start; max-width: 560px; }
  {{ sid }} .ssa__title { margin: 0; font-family: var(--ss-display); font-weight: var(--ss-display-weight); font-size: clamp(44px, 5vw, 84px); line-height: 1; letter-spacing: var(--ss-track-display); text-transform: uppercase; color: var(--ss-plum); }
  {{ sid }} .ssa__claim { margin: 0; font-family: var(--ss-display); font-size: clamp(20px, 1.6vw, 26px); line-height: 1.2; color: var(--ss-ink); }
  {{ sid }} .ssa__text { display: grid; gap: 14px; font-size: 18px; line-height: 1.6; }
  {{ sid }} .ssa__text p { margin: 0; }
  {{ sid }} .ssa__btn { margin-top: 8px; }
  {{ sid }} .ssa__stack { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 620px; justify-self: center; }
  {{ sid }} .ssa__frame { position: absolute; margin: 0; padding: clamp(8px, 1vw, 14px); padding-bottom: clamp(28px, 3vw, 48px); background: var(--ss-white); box-shadow: 0 18px 40px rgba(117, 31, 101, .18), 0 2px 6px rgba(29, 29, 27, .08); }
  {{ sid }} .ssa__frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  {{ sid }} .ssa__frame--1 { left: 0; bottom: 0; width: 64%; aspect-ratio: 4 / 5; transform: rotate(-4deg); z-index: 3; }
  {{ sid }} .ssa__frame--2 { right: 0; top: 0; width: 58%; aspect-ratio: 1 / 1; transform: rotate(5deg); z-index: 1; }
  {{ sid }} .ssa__frame--3 { right: 4%; bottom: 6%; width: 38%; aspect-ratio: 1 / 1; transform: rotate(9deg); z-index: 4; }
  {{ sid }} .ssa__frame > div { width: 100%; height: 100%; overflow: hidden; }
  @media (max-width: 860px) {
    {{ sid }} .ssa__inner { grid-template-columns: 1fr; }
    {{ sid }} .ssa__stack { max-width: 460px; }
  }
</style>
<section class="ss-scope ssa" id="SsAbout-{{ section.id }}" aria-labelledby="SsAboutTitle-{{ section.id }}">
  <div class="ssa__inner">
    <div class="ssa__copy">
      <h2 class="ssa__title" id="SsAboutTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.claim != blank -%}<p class="ssa__claim">{{ section.settings.claim }}</p>{%- endif -%}
      <div class="ssa__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="ss-btn ssa__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="ssa__stack">
      <figure class="ssa__frame ssa__frame--2"><div>
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 60vw, 30vw', alt: section.settings.image_2.alt }}
        {%- else -%}
          <img src="{{ 'launch-scene-1400.webp' | asset_url }}" alt="" loading="lazy" width="1400" height="782" style="object-position: 30% 100%">
        {%- endif -%}
      </div></figure>
      {%- if section.settings.image_1 != blank -%}
        <figure class="ssa__frame ssa__frame--1"><div>{{ section.settings.image_1 | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 70vw, 34vw', alt: section.settings.image_1.alt }}</div></figure>
      {%- endif -%}
      {%- if section.settings.image_3 != blank -%}
        <figure class="ssa__frame ssa__frame--3"><div>{{ section.settings.image_3 | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 40vw, 20vw', alt: section.settings.image_3.alt }}</div></figure>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soapsister Über uns",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Über uns" },
    { "type": "text", "id": "claim", "label": "Zeile unter der Überschrift", "default": "For skin, soul and sisterhood." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Soapsister ist eine Marke aus München, gegründet von Veronika Löwen. Die Idee dahinter: Duschen soll nicht nur sauber machen, sondern sich gut anfühlen. Für deine Haut, für deine Seele und für all die Frauen, die dir wichtig sind.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Mehr über uns" },
    { "type": "url", "id": "button_link", "label": "Ziel des Buttons" },
    { "type": "image_picker", "id": "image_1", "label": "Bild vorne (Hochformat)" },
    { "type": "image_picker", "id": "image_2", "label": "Bild hinten (quadratisch)", "info": "Leer: die Wolkenszene liegt dahinter." },
    { "type": "image_picker", "id": "image_3", "label": "Kleines Bild vorne rechts (optional)" }
  ],
  "presets": [{ "name": "Soapsister Über uns" }]
}
{% endschema %}
