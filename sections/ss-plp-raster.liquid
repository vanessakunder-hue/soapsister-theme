{%- comment -%}
  Soapsister Kategorieseite als ruhiges Raster (26.11.2026), z. B. fuer Badeente und Netzschwamm.
  Pro Block eine Reihe: links Name und Text, rechts die Produkte als Farbkarten mit direktem Warenkorb-Button.
  Die Kartenfarbe ergibt sich aus dem Produkt-Handle (rosa, weiss, blau) oder aus der Einstellung.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
<script src="{{ 'ssh-bubble-fly.js' | asset_url }}" defer></script>
{%- assign st = section.settings -%}
<section class="ss-scope ssh-ras" id="SshRas-{{ section.id }}" data-bubble="{{ 'soapsister-seifenblase-rosa.png' | file_url }}" style="--btn:{{ st.button }}">
  <div class="ssh-ras__intro">
    <h1 class="ssh-ras__h1">{{ st.heading | default: collection.title | escape }}</h1>
    {%- if st.text != blank -%}<p class="ssh-ras__lead">{{ st.text | escape }}</p>{%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign c = block.settings -%}
    <div class="ssh-ras__row" {{ block.shopify_attributes }}>
      <div class="ssh-ras__head">
        <h2 class="ssh-ras__h2">{{ c.title | escape }}</h2>
        {%- if c.text != blank -%}<p class="ssh-ras__text">{{ c.text | escape }}</p>{%- endif -%}
      </div>
      <ul class="ssh-ras__cards" role="list">
        {%- for p in c.products -%}
          {%- liquid
            assign h = p.handle
            assign tint = '#ECEAE4'
            if h contains 'rosa'
              assign tint = '#F6E2EE'
            elsif h contains 'blau'
              assign tint = '#DDF0FA'
            endif
            assign label = p.title
            if c.strip != blank
              assign label = p.title | remove: c.strip | strip
            endif
            assign v = p.selected_or_first_available_variant
          -%}
          <li class="ssh-ras__card" style="--tint:{{ tint }}">
            <a class="ssh-ras__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 700 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 749px) 60vw, 22vw', widths: '300, 450, 600, 700' }}{%- endif -%}
            </a>
            <div class="ssh-ras__body">
              <div class="ssh-ras__meta">
                <h3 class="ssh-ras__name"><a href="{{ p.url }}">{{ label | escape }}<span class="visually-hidden"> {{ p.title | escape }}</span></a></h3>
                <span class="ssh-ras__price">{{ v.price | money }}</span>
              </div>
              <form action="{{ routes.cart_add_url }}" method="post" class="ssh-ras__form">
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="ssh-ras__add" {% unless v.available %}disabled{% endunless %}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                  <span data-label>{% if v.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
                  <span class="visually-hidden">: {{ p.title | escape }}</span>
                </button>
              </form>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endfor -%}

  <p class="ssh-ras__note">inkl. MwSt., zzgl. Versand</p>

  {%- if st.set_title != blank -%}
    {%- liquid
      assign setp = st.set_product
      assign sum = 0
      if st.set_mousse != blank
        assign sum = sum | plus: st.set_mousse.variants.first.price
      endif
      if st.set_duck != blank
        assign sum = sum | plus: st.set_duck.price
      endif
      if st.set_sponge != blank
        assign sum = sum | plus: st.set_sponge.price
      endif
    -%}
    <div class="ssh-ras__band">
      <div class="ssh-ras__band-in">
        <div class="ssh-ras__band-media" aria-hidden="true">
          {%- if st.set_duck.featured_image -%}{{ st.set_duck.featured_image | image_url: width: 320 | image_tag: alt: '', loading: 'lazy', class: 'ssh-ras__band-duck', sizes: '110px' }}{%- endif -%}
          {%- if st.set_jar != blank -%}{{ st.set_jar | image_url: width: 400 | image_tag: alt: '', loading: 'lazy', class: 'ssh-ras__band-jar', sizes: '140px' }}{%- endif -%}
          {%- if st.set_sponge.featured_image -%}{{ st.set_sponge.featured_image | image_url: width: 320 | image_tag: alt: '', loading: 'lazy', class: 'ssh-ras__band-sponge', sizes: '100px' }}{%- endif -%}
        </div>
        <div class="ssh-ras__band-text">
          <h2 class="ssh-ras__band-h">{{ st.set_title | escape }}{% if st.set_title2 != blank %}<br>{{ st.set_title2 | escape }}{% endif %}</h2>
          {%- if st.set_text != blank -%}<p>{{ st.set_text | escape }}{% if setp != blank %} für {{ setp.price | money }}{% if sum > setp.price %} statt {{ sum | money }}{% endif %}{% endif %}.</p>{%- endif -%}
        </div>
        <a class="ssh-ras__band-btn" href="{{ st.set_link | default: '/collections/sets' }}">{{ st.set_label | escape }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .ssh-ras{background:var(--color-background,#F1F1E9);color:#1D1D1B;padding-bottom:0}
  .ssh-ras a{color:inherit;text-decoration:none}
  .ssh-ras__intro{padding:64px 7.4% 56px;display:flex;flex-direction:column;gap:14px}
  .ssh-ras__h1{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(56px,6.4vw,96px);line-height:.92;overflow-wrap:normal}
  .ssh-ras__lead{margin:0;font-size:20px;line-height:1.45;max-width:46ch}
  .ssh-ras__row{margin:0 7.4%;padding:48px 0;border-top:2px solid rgba(29,29,27,.12);display:grid;grid-template-columns:minmax(220px,1fr) minmax(0,3fr);gap:40px;align-items:start}
  .ssh-ras__head{display:flex;flex-direction:column;gap:12px;position:sticky;top:120px}
  .ssh-ras__h2{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(36px,3.3vw,52px);line-height:.92;white-space:nowrap;overflow-wrap:normal}
  .ssh-ras__text{margin:0;font-size:18px;line-height:1.45;max-width:28ch}
  .ssh-ras__cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .ssh-ras__card{display:flex;flex-direction:column;border-radius:28px;background:var(--tint);overflow:hidden;min-width:0}
  .ssh-ras__media{position:relative;display:block;aspect-ratio:1/1}
  .ssh-ras__media img{position:absolute;inset:12%;width:76%;height:76%;object-fit:contain;display:block;filter:drop-shadow(0 18px 18px rgba(29,29,27,.16));transition:transform .5s cubic-bezier(.3,1.5,.5,1)}
  .ssh-ras__card:hover .ssh-ras__media img{transform:translateY(-8px) rotate(-2deg)}
  .ssh-ras__body{display:flex;flex-direction:column;gap:14px;padding:0 20px 20px}
  .ssh-ras__meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .ssh-ras__name{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:32px;line-height:1}
  .ssh-ras__name a:focus-visible{outline:3px solid var(--btn);outline-offset:4px}
  .ssh-ras__price{font-weight:600;font-size:20px;white-space:nowrap}
  .ssh-ras__form{margin:0}
  .ssh-ras__add{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 16px;border:2px solid var(--btn);border-radius:999px;background:#FFFFFF;color:var(--btn);cursor:pointer;font-family:inherit;font-weight:600;font-size:15px;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;transition:background .2s,color .2s}
  .ssh-ras__add:hover,.ssh-ras__add:focus-visible{background:var(--btn);color:#FFFFFF}
  .ssh-ras__add:focus-visible{outline:3px solid var(--btn);outline-offset:3px}
  .ssh-ras__add:disabled{opacity:.5;cursor:not-allowed}
  .ssh-ras__note{margin:0 7.4%;padding-top:8px;font-size:13px;opacity:.7}
  .ssh-ras__set{margin:72px 7.4% 0;padding:28px 0;border-top:2px solid rgba(29,29,27,.15);border-bottom:2px solid rgba(29,29,27,.15);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;font-size:20px}
  .ssh-ras__set a{display:flex;align-items:center;gap:8px;font-weight:600;font-size:17px;letter-spacing:.12em;text-transform:uppercase}
  .ssh-ras .ssh-ras__set a{color:var(--btn)}
  .ssh-ras__band{margin-top:72px;background:var(--band,#F6E2EE);color:#751F65}
  .ssh-ras__band-in{padding:40px 7.4%;display:flex;align-items:center;gap:40px;flex-wrap:wrap}
  .ssh-ras__band-media{position:relative;flex:0 0 auto;width:300px;height:150px}
  .ssh-ras__band-media img{position:absolute;bottom:0;height:auto;display:block;filter:drop-shadow(0 12px 12px rgba(117,31,101,.18))}
  .ssh-ras__band-duck{left:0;width:100px;z-index:1}
  .ssh-ras__band-jar{left:70px;width:150px;bottom:6px}
  .ssh-ras__band-sponge{left:200px;width:96px;z-index:2}
  .ssh-ras__band-text{flex:1 1 320px;min-width:0;display:flex;flex-direction:column;gap:10px}
  .ssh-ras__band-h{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(34px,3.2vw,48px);line-height:.95;color:#751F65}
  .ssh-ras__band-text p{margin:0;font-size:17px;line-height:1.45;color:#4A1240}
  .ssh-ras__band-btn{display:flex;align-items:center;gap:10px;border:2px solid #751F65;border-radius:999px;min-height:48px;padding:0 24px;font-weight:600;font-size:15px;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;transition:background .2s,color .2s}
  .ssh-ras .ssh-ras__band-btn{color:#751F65}
  .ssh-ras .ssh-ras__band-btn:hover,.ssh-ras .ssh-ras__band-btn:focus-visible{background:#751F65;color:#FFFFFF}
  .ssh-ras__band-btn:focus-visible{outline:3px solid #751F65;outline-offset:3px}
  @media (max-width:749px){.ssh-ras__band{margin-top:48px}.ssh-ras__band-in{padding:32px 20px;gap:24px}.ssh-ras__band-media{width:260px;height:130px}.ssh-ras__band-duck{width:86px}.ssh-ras__band-jar{left:60px;width:130px}.ssh-ras__band-sponge{left:172px;width:84px}}
  @media (max-width:1099px){.ssh-ras__row{grid-template-columns:minmax(0,1fr);gap:24px}.ssh-ras__head{position:static}}
  @media (max-width:749px){
    .ssh-ras{padding-bottom:0}
    .ssh-ras__intro{padding:40px 20px 36px}
    .ssh-ras__h1{font-size:clamp(40px,11vw,56px)}
    .ssh-ras__lead{font-size:18px}
    .ssh-ras__row{margin:0 20px;padding:36px 0}
    .ssh-ras__cards{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:20px;gap:12px;margin:0 -20px;padding:0 20px 6px;scrollbar-width:none}
    .ssh-ras__h2{font-size:40px}
    .ssh-ras__cards::-webkit-scrollbar{display:none}
    .ssh-ras__card{flex:0 0 68vw;scroll-snap-align:start}
    .ssh-ras__name{font-size:28px}
    .ssh-ras__note{margin:0 20px}
    .ssh-ras__set{margin:48px 20px 0;font-size:18px}
  }
  @media (prefers-reduced-motion:reduce){.ssh-ras__media img,.ssh-ras__add{transition:none}}
</style>

<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';
  const root = document.getElementById('SshRas-{{ section.id }}');
  if (root) {
    root.addEventListener('submit', async (e) => {
      const form = e.target.closest('form.ssh-ras__form');
      if (!form) return;
      e.preventDefault();
      const btn = form.querySelector('.ssh-ras__add'), label = btn.querySelector('[data-label]');
      if (btn.disabled) return;
      const idle = label.textContent;
      btn.disabled = true; label.textContent = 'Wird hinzugefügt';
      const fd = new FormData(form);
      const ids = Array.from(document.querySelectorAll('cart-items-component')).map((el) => el.dataset.sectionId).filter(Boolean);
      if (ids.length) fd.append('sections', ids.join(','));
      let deferred = null;
      try {
        deferred = CartLinesUpdateEvent.createPromise();
        form.dispatchEvent(new CartLinesUpdateEvent({ action: 'add', context: 'product', lines: [{ merchandiseId: String(fd.get('id')), quantity: 1 }], promise: deferred.promise }));
      } catch (x) { deferred = null; }
      const routes = (window.Theme && window.Theme.routes) || {};
      let added = false;
      try {
        const res = await fetch(routes.cart_add_url || '/cart/add', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/javascript' } });
        const data = await res.json();
        added = !data.status;
        const cart = await fetch((routes.cart_url || '/cart') + '.json', { headers: { Accept: 'application/json' } }).then((r) => r.json());
        if (data.status) {
          form.dispatchEvent(new CartErrorEvent({ error: data.message || 'Add to cart failed', code: 'INVALID', detail: { description: data.description } }));
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: true, items: cart.items, source: 'ssh-ras', sourceId: root.id, itemCount: 1 } });
          label.textContent = data.description || 'Nicht verfügbar';
          setTimeout(() => { label.textContent = idle; }, 2400);
        } else {
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: false, items: cart.items, source: 'ssh-ras', sourceId: root.id, itemCount: 1, sections: data.sections } });
          if (!deferred) { location.href = routes.cart_url || '/cart'; return; }
          if (window.sshBubbleFly) window.sshBubbleFly(btn, root.dataset.bubble, getComputedStyle(root).getPropertyValue('--btn'));
          label.textContent = 'Hinzugefügt';
          setTimeout(() => { label.textContent = idle; }, 1800);
        }
      } catch (x) {
        if (deferred && deferred.reject) deferred.reject(x);
        if (added) { location.href = routes.cart_url || '/cart'; } else { form.submit(); }
        return;
      }
      btn.disabled = false;
    });
  }
</script>

{% schema %}
{
  "name": "Soapsister: Raster",
  "tag": "div",
  "class": "ssh-ras-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (leer = Name der Kollektion)" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "color", "id": "button", "label": "Farbe Buttons", "default": "#1D3F52" },
    { "type": "header", "content": "Hinweis auf die Sets" },
    { "type": "text", "id": "set_title", "label": "Überschrift (leer = ausblenden)", "default": "Mit Duschmousse" },
    { "type": "text", "id": "set_title2", "label": "Überschrift Zeile 2", "default": "wird's ein Set." },
    { "type": "text", "id": "set_text", "label": "Text", "default": "Mousse, Netzschwamm und Badeente zusammen" },
    { "type": "product", "id": "set_mousse", "label": "Duschmousse (Einzelpreis, erste Größe)" },
    { "type": "product", "id": "set_duck", "label": "Badeente (Bild und Einzelpreis)" },
    { "type": "product", "id": "set_sponge", "label": "Netzschwamm (Bild und Einzelpreis)" },
    { "type": "image_picker", "id": "set_jar", "label": "Freigestellte Dose" },
    { "type": "product", "id": "set_product", "label": "Set-Produkt für den Preis" },
    { "type": "text", "id": "set_label", "label": "Link-Text", "default": "Set zusammenstellen" },
    { "type": "url", "id": "set_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Reihe",
      "settings": [
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Badeente." },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "product_list", "id": "products", "label": "Produkte", "limit": 6 },
        { "type": "text", "id": "strip", "label": "Aus dem Produktnamen entfernen", "info": "Zum Beispiel Badeente, dann steht auf der Karte nur die Farbe." }
      ]
    }
  ],
  "presets": [{ "name": "Soapsister: Raster" }]
}
{% endschema %}
