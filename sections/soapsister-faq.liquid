{%- comment -%}
  Soapsister FAQ: Fragen und Antworten zum Aufklappen, im runden Soapsister-Stil.
{%- endcomment -%}

<div class="section section--page-width">
  <div
    class="soapsister-faq"
    style="
      --faq-accent: {{ section.settings.accent_color }};
      --faq-radius: {{ section.settings.corner_radius }}px;
      padding-block-start: {{ section.settings.padding-block-start }}px;
      padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="soapsister-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="soapsister-faq__list">
      {%- for block in section.blocks -%}
        <details class="soapsister-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="soapsister-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .soapsister-faq {
    display: grid;
    gap: 24px;
    max-width: 860px;
    margin-inline: auto;
  }

  .soapsister-faq__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    text-align: center;
  }

  .soapsister-faq__list {
    display: grid;
    gap: 8px;
  }

  .soapsister-faq__item {
    padding: 0 20px;
    background: rgb(255 255 255 / 0.6);
    border-radius: calc(var(--faq-radius) / 1.5);
  }

  .soapsister-faq__item summary {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 18px 0;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .soapsister-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .soapsister-faq__item summary::after {
    content: '+';
    color: var(--faq-accent);
  }

  .soapsister-faq__item[open] summary::after {
    content: '−';
  }

  .soapsister-faq__answer {
    padding-bottom: 18px;
  }

  .soapsister-faq__answer p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Soapsister FAQ",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Fragen zur Duschmousse"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Farbe des Plus-Zeichens",
      "default": "#751F65"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Abrundung der Ecken",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Frage",
          "default": "Frage"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwort",
          "default": "<p>Antwort</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soapsister FAQ"
    }
  ]
}
{% endschema %}
