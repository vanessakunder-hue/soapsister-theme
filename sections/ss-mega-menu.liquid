{%- comment -%}
  Soapsister Mega-Menue nach Design "Navi 2: Sahnehauben-Menue" (25.11.2026).
  Oeffnet sich beim Hovern ueber einen Hauptmenuepunkt (ab 990 px).
  Ein Block "Panel" startet ein Menue fuer einen Menuepunkt. Die folgenden Bloecke "Link" (links)
  und "Karte" (rechts) gehoeren zu diesem Panel. Beim Hover ueber eine Karte faerbt sich die Flaeche.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
{%- assign edge = 'M0 0H1440V30a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0a30 30 0 0 1 -60 0Z' -%}
<ssh-mega class="ss-scope ssh-mega" data-close-delay="220">
  {%- for p in section.blocks -%}
    {%- if p.type == 'panel' -%}
      {%- assign pnext = forloop.index -%}
      <div class="ssh-n2" id="SshNav2-{{ section.id }}-{{ forloop.index }}" data-for="{{ p.settings.menu_item | strip | downcase | escape }}" data-base="{{ p.settings.base }}" role="region" aria-label="{{ p.settings.menu_item | escape }}" style="--sheet:{{ p.settings.base }}" {{ p.shopify_attributes }}>
        <div class="ssh-n2__sheet">
          <ul class="ssh-n2__links" role="list">
            {%- for b in section.blocks offset: pnext -%}
              {%- if b.type == 'panel' -%}{%- break -%}{%- endif -%}
              {%- if b.type == 'link' -%}
                <li {{ b.shopify_attributes }}><a class="ssh-n2__link" href="{{ b.settings.link | default: routes.all_products_collection_url }}">{{ b.settings.label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- assign ccount = 0 -%}{%- for b in section.blocks offset: pnext -%}{%- if b.type == 'panel' -%}{%- break -%}{%- endif -%}{%- if b.type == 'card' -%}{%- assign ccount = ccount | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if ccount == 1 -%}{%- assign csizes = '(min-width: 990px) 55vw, 1px' -%}{%- else -%}{%- assign csizes = '(min-width: 990px) 18vw, 1px' -%}{%- endif -%}
          <div class="ssh-n2__cards">
            {%- for b in section.blocks offset: pnext -%}
              {%- if b.type == 'panel' -%}{%- break -%}{%- endif -%}
              {%- if b.type == 'card' -%}
                <a class="ssh-n2__card" href="{{ b.settings.link | default: routes.all_products_collection_url }}" data-tint="{{ b.settings.tint }}" {{ b.shopify_attributes }}>
                  <span class="ssh-n2__disc">
                    {%- if b.settings.image != blank -%}
                      {{ b.settings.image | image_url: width: 1800 | image_tag: alt: '', loading: 'lazy', sizes: csizes, widths: '400, 600, 800, 1100, 1400, 1800', style: b.settings.focus }}
                    {%- endif -%}
                  </span>
                  <span class="ssh-n2__t">{{ b.settings.title | escape }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                  {%- if b.settings.subtitle != blank -%}<span class="ssh-n2__s">{{ b.settings.subtitle | escape }}</span>{%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <svg class="ssh-n2__edge" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="{{ edge }}"/></svg>
      </div>
    {%- endif -%}
  {%- endfor -%}
</ssh-mega>

<style>
  .ssh-mega{position:fixed;left:0;right:0;top:var(--ssh-mega-top,80px);z-index:30;pointer-events:none;display:block}
  .ssh-n2{position:absolute;left:0;right:0;top:0;pointer-events:none;visibility:hidden;opacity:0;transform:translateY(-14px);
    transition:opacity .3s,visibility .3s,transform .45s cubic-bezier(.3,1.3,.5,1);filter:drop-shadow(0 14px 14px rgba(117,31,101,.14))}
  .ssh-n2.is-open{pointer-events:auto;visibility:visible;opacity:1;transform:none}
  .ssh-n2__sheet{background:var(--sheet);padding:40px 7.8% 28px 7.4%;display:flex;gap:64px;align-items:flex-start;transition:background .35s}
  .ssh-n2__edge{display:block;width:100%;height:44px;margin-top:-1px}
  .ssh-n2__edge path{fill:var(--sheet);transition:fill .35s}
  .ssh-n2__links{flex:1 1 300px;min-width:260px;list-style:none;margin:0;padding:8px 0 0;display:flex;flex-direction:column;gap:4px}
  .ssh-n2__link{display:flex;align-items:center;min-height:44px;font-family:var(--font-subheading--family,var(--ss-text));font-weight:600;font-size:24px;letter-spacing:.04em;color:#751F65;text-decoration:none;transition:transform .25s}
  .ssh-n2__link:hover{transform:translateX(4px)}
  .ssh-n2__cards{flex:0 1 780px;display:flex;gap:28px;margin-left:auto}
  .ssh-n2__card{flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:12px;color:inherit;text-decoration:none}
  .ssh-n2__disc{width:100%;aspect-ratio:4/3;border-radius:26px;overflow:hidden;display:block;background:rgba(255,255,255,.4)}
  .ssh-n2__disc img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s ease}
  .ssh-n2__card:hover .ssh-n2__disc img,.ssh-n2__card:focus-visible .ssh-n2__disc img{transform:scale(1.06)}
  .ssh-n2__t{display:flex;align-items:center;gap:10px;font-family:var(--font-subheading--family,var(--ss-text));font-weight:600;font-size:20px;letter-spacing:.06em;text-transform:uppercase;color:#751F65}
  .ssh-n2__t svg{transition:transform .25s}
  .ssh-n2__card:hover .ssh-n2__t svg{transform:translateX(4px)}
  .ssh-n2__s{font-size:15px;color:#1D1D1B}
  .ssh-n2__card:only-child .ssh-n2__disc{aspect-ratio:16/7}
  .ssh-n2__link:focus-visible,.ssh-n2__card:focus-visible{outline:3px solid #751F65;outline-offset:4px;border-radius:12px}
  .ssh-n2-chev{display:inline-block;margin-left:6px;vertical-align:middle;transition:transform .3s}
  [aria-expanded="true"] .ssh-n2-chev{transform:rotate(180deg)}
  [data-ssh-mega] .menu-list__link-title{white-space:nowrap}



  @media (max-width:989px){.ssh-mega{display:none}}
  @media (prefers-reduced-motion:reduce){
    .ssh-n2,.ssh-n2__sheet,.ssh-n2__edge path,.ssh-n2__disc img,.ssh-n2__link,.ssh-n2-chev,.ssh-n2__t svg{transition:none}
  }
</style>

<script>
  if (!customElements.get('ssh-mega')) {
    customElements.define('ssh-mega', class extends HTMLElement {
      connectedCallback() {
        this.delay = Number(this.dataset.closeDelay || 220);
        this.panels = [...this.querySelectorAll('.ssh-n2')];
        this.links = [];
        const map = {};
        this.panels.forEach((p) => { map[p.dataset.for.trim()] = p; });
        const chev = '<svg class="ssh-n2-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
        document.querySelectorAll('#header-component .menu-list__link').forEach((a) => {
          const titleEl = a.querySelector('.menu-list__link-title') || a;
          const panel = map[titleEl.textContent.trim().toLowerCase()];
          if (!panel || a.dataset.sshMega) return;
          a.dataset.sshMega = '1';
          a.setAttribute('aria-expanded', 'false');
          a.setAttribute('aria-controls', panel.id);
          if (!a.querySelector('.ssh-n2-chev')) titleEl.insertAdjacentHTML('beforeend', chev);
          this.links.push({ a, panel });
          a.addEventListener('mouseenter', () => this.open(panel));
          a.addEventListener('mouseleave', () => this.later());
          a.addEventListener('focus', () => this.open(panel));
          a.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown') { e.preventDefault(); this.open(panel); const f = panel.querySelector('a'); if (f) f.focus(); }
            if (e.key === 'Escape') this.close();
          });
        });
        this.panels.forEach((p) => {
          p.addEventListener('mouseenter', () => clearTimeout(this.t));
          p.addEventListener('mouseleave', () => this.later());
          p.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const l = this.linkFor(p); this.close(); if (l) l.focus(); } });
          p.addEventListener('focusout', (e) => { if (!p.contains(e.relatedTarget) && e.relatedTarget !== this.linkFor(p)) this.later(); });
          p.querySelectorAll('.ssh-n2__card').forEach((c) => {
            const on = () => p.style.setProperty('--sheet', c.dataset.tint || p.dataset.base);
            const off = () => p.style.setProperty('--sheet', p.dataset.base);
            c.addEventListener('mouseenter', on);
            c.addEventListener('focus', on);
            c.addEventListener('mouseleave', off);
            c.addEventListener('blur', off);
          });
        });
        this.onDoc = (e) => {
          if (!this.current) return;
          if (this.current.contains(e.target) || this.links.some((l) => l.a.contains(e.target))) return;
          this.close();
        };
        document.addEventListener('pointerdown', this.onDoc);
      }
      disconnectedCallback() { if (this.onDoc) document.removeEventListener('pointerdown', this.onDoc); }
      linkFor(p) { const l = this.links.find((x) => x.panel === p); return l ? l.a : null; }
      place() {
        const h = document.querySelector('#header-component');
        if (h) this.style.setProperty('--ssh-mega-top', Math.round(h.getBoundingClientRect().bottom) + 'px');
      }
      open(panel) {
        if (!window.matchMedia('(min-width: 990px)').matches) return;
        clearTimeout(this.t);
        this.place();
        this.panels.forEach((p) => { if (p !== panel) { p.classList.remove('is-open'); p.style.setProperty('--sheet', p.dataset.base); } });
        panel.classList.add('is-open');
        this.links.forEach((l) => l.a.setAttribute('aria-expanded', String(l.panel === panel)));
        this.current = panel;
      }
      later() { clearTimeout(this.t); this.t = setTimeout(() => this.close(), this.delay); }
      close() {
        clearTimeout(this.t);
        this.panels.forEach((p) => { p.classList.remove('is-open'); p.style.setProperty('--sheet', p.dataset.base); });
        this.links.forEach((l) => l.a.setAttribute('aria-expanded', 'false'));
        this.current = null;
      }
    });
  }
</script>

{% schema %}
{
  "name": "Soapsister: Mega-Menü",
  "tag": "div",
  "class": "ssh-mega-section",
  "enabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Sahnehauben-Menü (Desktop). Ein Block \"Panel\" startet das Menü für einen Menüpunkt. Die Links und Karten darunter gehören zu diesem Panel, bis das nächste Panel kommt." }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menüpunkt", "info": "Genau wie im Hauptmenü, z. B. Shop", "default": "Shop" },
        { "type": "color", "id": "base", "label": "Flächenfarbe", "default": "#FBF0F6" }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "Lollipop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "select", "id": "focus", "label": "Bildausschnitt", "options": [
          { "value": "object-position:50% 50%", "label": "Mitte" },
          { "value": "object-position:50% 30%", "label": "Oben" },
          { "value": "object-position:50% 70%", "label": "Unten" }
        ], "default": "object-position:50% 50%" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Duschmousse" },
        { "type": "text", "id": "subtitle", "label": "Unterzeile" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "tint", "label": "Flächenfarbe beim Hover", "default": "#F6D3E6" }
      ]
    }
  ],
  "presets": [{ "name": "Soapsister: Mega-Menü" }]
}
{% endschema %}
