{%- comment -%}
  Soapsister Mega-Menue: oeffnet sich beim Hovern ueber einen Hauptmenuepunkt (ab 990 px).
  Jeder Block ist eine Kategorie. Bloecke mit demselben "Menuepunkt" bilden zusammen ein Panel.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
{%- assign bubble = 'soapsister-seifenblase-rosa.png' | file_url -%}
{%- assign items = '' -%}
{%- for b in section.blocks -%}
  {%- assign key = b.settings.menu_item | strip -%}
  {%- assign probe = '|' | append: key | append: '|' -%}
  {%- assign hay = '|' | append: items | append: '|' -%}
  {%- unless hay contains probe or key == blank -%}
    {%- if items == '' -%}{%- assign items = key -%}{%- else -%}{%- assign items = items | append: '|' | append: key -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign item_list = items | split: '|' -%}

<ssh-mega class="ss-scope ssh-mega" data-close-delay="220">
  {%- for item in item_list -%}
    <div class="ssh-mega__panel" id="SshMega-{{ section.id }}-{{ forloop.index }}" data-for="{{ item | downcase | escape }}" role="region" aria-label="{{ item | escape }}" hidden>
      <span class="ssh-mega__float ssh-mega__float--a" aria-hidden="true" style="background-image:url({{ bubble }})"></span>
      <span class="ssh-mega__float ssh-mega__float--b" aria-hidden="true" style="background-image:url({{ bubble }})"></span>
      <div class="ssh-mega__in">
        <div class="ssh-mega__groups">
          {%- assign gi = 0 -%}
          {%- for b in section.blocks -%}
            {%- assign k = b.settings.menu_item | strip -%}
            {%- if k == item -%}
              <a class="ssh-mega__group{% if gi == 0 %} is-on{% endif %}" href="{{ b.settings.link | default: routes.all_products_collection_url }}" data-g="{{ gi }}" {{ b.shopify_attributes }}>
                <span class="ssh-mega__gt">{{ b.settings.title | escape }}</span>
                {%- if b.settings.subtitle != blank -%}<span class="ssh-mega__gs">{{ b.settings.subtitle | escape }}</span>{%- endif -%}
              </a>
              {%- assign gi = gi | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="ssh-mega__all" href="{{ routes.all_products_collection_url }}">Alle Produkte ansehen <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="ssh-mega__stage">
          {%- assign gi = 0 -%}
          {%- for b in section.blocks -%}
            {%- assign k = b.settings.menu_item | strip -%}
            {%- if k == item -%}
              <ul class="ssh-mega__set{% if gi == 0 %} is-on{% endif %}" data-g="{{ gi }}" role="list">
                {%- for p in b.settings.products -%}
                  {%- assign h = p.handle -%}
                  {%- assign ring = '#751F65' -%}
                  {%- if h contains 'lollipop' or h contains 'rosa' -%}{%- assign ring = '#E08FBC' -%}
                  {%- elsif h contains 'coconut' or h contains 'weiss' -%}{%- assign ring = '#CAC8C4' -%}
                  {%- elsif h contains 'marshmallow' or h contains 'blau' -%}{%- assign ring = '#21B5EA' -%}{%- endif -%}
                  {%- assign short = p.title | remove: 'Duschmousse ' | remove: 'Feelgood Set ' -%}
                  <li style="--ring:{{ ring }};--i:{{ forloop.index0 }}">
                    <a class="ssh-mega__bub" href="{{ p.url }}">
                      <span class="ssh-mega__ring">
                        {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 360 | image_tag: alt: '', loading: 'lazy', width: 180, height: 180 }}{%- endif -%}
                      </span>
                      <span class="ssh-mega__name">{{ short | escape }}</span>
                      <span class="ssh-mega__price">{% if p.price_varies %}ab {% endif %}{{ p.price_min | money }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
              {%- assign gi = gi | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</ssh-mega>

<style>
  .ssh-mega{position:fixed;left:0;right:0;top:var(--ssh-mega-top,80px);z-index:30;pointer-events:none;display:block;filter:drop-shadow(0 14px 18px rgba(117,31,101,.28)) drop-shadow(0 2px 3px rgba(117,31,101,.18))}
  .ssh-mega__panel{position:absolute;left:0;right:0;top:0;pointer-events:auto;background:#EAEDE8;color:#1D1D1B;padding:40px 7.4% 64px;overflow:hidden;
    -webkit-mask:radial-gradient(circle at 50% 0,#000 69%,transparent 71%) bottom/44px 22px repeat-x,linear-gradient(#000,#000) top/100% calc(100% - 21px) no-repeat;
            mask:radial-gradient(circle at 50% 0,#000 69%,transparent 71%) bottom/44px 22px repeat-x,linear-gradient(#000,#000) top/100% calc(100% - 21px) no-repeat;
    clip-path:inset(0 0 100% 0);transition:clip-path .45s cubic-bezier(.2,.8,.2,1)}
  .ssh-mega__panel[hidden]{display:block;visibility:hidden}
  .ssh-mega__panel.is-open{visibility:visible;clip-path:inset(0 0 -40px 0)}
  .ssh-mega__in{position:relative;z-index:2;display:grid;grid-template-columns:minmax(220px,300px) 1fr;gap:56px;align-items:start;max-width:1280px;margin:0 auto}
  .ssh-mega__groups{display:flex;flex-direction:column;gap:6px}
  .ssh-mega__group{display:flex;flex-direction:column;gap:2px;padding:10px 0 10px 26px;position:relative;color:inherit;text-decoration:none}
  .ssh-mega__group::before{content:"";position:absolute;left:0;top:19px;width:14px;height:14px;border-radius:50%;border:2px solid #751F65;transform:scale(.4);opacity:0;transition:transform .35s cubic-bezier(.3,1.6,.5,1),opacity .2s}
  .ssh-mega__group.is-on::before{transform:scale(1);opacity:1}
  .ssh-mega__gt{font-family:var(--ss-display,sans-serif);font-weight:900;font-size:34px;line-height:1;text-transform:uppercase;transition:color .2s}
  .ssh-mega__group.is-on .ssh-mega__gt,.ssh-mega__group:hover .ssh-mega__gt{color:#751F65}
  .ssh-mega__gs{font-size:15px;opacity:.7}
  .ssh-mega__all{margin-top:14px;padding-left:26px;font-weight:600;font-size:15px;letter-spacing:.06em;color:#751F65;text-decoration:none}
  .ssh-mega__all:hover{text-decoration:underline}
  .ssh-mega__stage{position:relative;min-height:250px}
  .ssh-mega__set{list-style:none;margin:0;padding:0;display:flex;gap:28px;flex-wrap:wrap;position:absolute;inset:0 auto auto 0;visibility:hidden}
  .ssh-mega__set.is-on{position:relative;visibility:visible}
  .ssh-mega__bub{display:flex;flex-direction:column;align-items:center;gap:10px;width:170px;text-align:center;color:inherit;text-decoration:none}
  .ssh-mega__ring{position:relative;width:170px;height:170px;border-radius:50%;display:grid;place-items:center;overflow:hidden;
    background:radial-gradient(circle at 32% 28%,#FFFFFF 0 10%,color-mix(in srgb,var(--ring) 22%,#FFFFFF) 11% 100%);
    box-shadow:inset 0 0 0 3px var(--ring),inset 0 0 24px color-mix(in srgb,var(--ring) 45%,transparent),0 10px 22px rgba(117,31,101,.14);
    transform:scale(.35);opacity:0;transition:transform .55s cubic-bezier(.3,1.6,.5,1),opacity .3s}
  .ssh-mega__ring img{width:78%;height:78%;object-fit:contain;display:block;mix-blend-mode:multiply;transition:transform .35s cubic-bezier(.3,1.6,.5,1)}
  .ssh-mega__ring::after{content:"";position:absolute;left:20%;top:14%;width:20%;height:13%;border-radius:50%;background:rgba(255,255,255,.85);transform:rotate(-30deg)}
  .ssh-mega__name{font-family:var(--ss-display,sans-serif);font-weight:900;font-size:22px;line-height:1;text-transform:uppercase;opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s}
  .ssh-mega__price{font-size:15px;opacity:0;transition:opacity .3s}
  .is-open .ssh-mega__set.is-on .ssh-mega__ring{transform:scale(1);opacity:1;transition-delay:calc(var(--i) * 70ms + 120ms)}
  .is-open .ssh-mega__set.is-on .ssh-mega__name{opacity:1;transform:none;transition-delay:calc(var(--i) * 70ms + 220ms)}
  .is-open .ssh-mega__set.is-on .ssh-mega__price{opacity:.75;transition-delay:calc(var(--i) * 70ms + 260ms)}
  .ssh-mega__bub:hover .ssh-mega__ring,.ssh-mega__bub:focus-visible .ssh-mega__ring{transform:scale(1.07)!important;transition-delay:0s!important}
  .ssh-mega__bub:hover img{transform:scale(1.08) rotate(-4deg)}
  .ssh-mega__bub:focus-visible{outline:none}
  .ssh-mega__bub:focus-visible .ssh-mega__ring{box-shadow:inset 0 0 0 3px var(--ring),0 0 0 3px #751F65}
  .ssh-mega__group:focus-visible,.ssh-mega__all:focus-visible{outline:3px solid #751F65;outline-offset:3px}
  .ssh-mega__float{position:absolute;z-index:1;border-radius:50%;background-size:cover;opacity:.8;animation:sshMegaFloat 7s ease-in-out infinite}
  .ssh-mega__float--a{width:90px;height:90px;right:4%;top:18px}
  .ssh-mega__float--b{width:46px;height:46px;right:12%;bottom:48px;animation-delay:-3s}
  @keyframes sshMegaFloat{0%,100%{translate:0 0}50%{translate:0 -12px}}


  @media (max-width:989px){.ssh-mega{display:none}}
  @media (prefers-reduced-motion:reduce){
    .ssh-mega__panel,.ssh-mega__ring,.ssh-mega__name,.ssh-mega__price,.ssh-mega__ring img{transition:none!important}
    .ssh-mega__float{animation:none}
  }
</style>

<script>
  if (!customElements.get('ssh-mega')) {
    customElements.define('ssh-mega', class extends HTMLElement {
      connectedCallback() {
        this.delay = Number(this.dataset.closeDelay || 220);
        this.panels = [...this.querySelectorAll('.ssh-mega__panel')];
        this.links = [];
        const map = {};
        this.panels.forEach((p) => { map[p.dataset.for.trim()] = p; });
        document.querySelectorAll('#header-component .menu-list__link').forEach((a) => {
          const t = (a.querySelector('.menu-list__link-title') || a).textContent.trim().toLowerCase();
          const panel = map[t];
          if (!panel || a.dataset.sshMega) return;
          a.dataset.sshMega = '1';
          a.setAttribute('aria-expanded', 'false');
          a.setAttribute('aria-controls', panel.id);
          this.links.push({ a, panel });
          a.addEventListener('mouseenter', () => this.open(panel, a));
          a.addEventListener('mouseleave', () => this.later());
          a.addEventListener('focus', () => this.open(panel, a));
          a.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown') { e.preventDefault(); this.open(panel, a); const f = panel.querySelector('a'); if (f) f.focus(); }
            if (e.key === 'Escape') this.close();
          });
        });
        this.panels.forEach((p) => {
          p.addEventListener('mouseenter', () => clearTimeout(this.t));
          p.addEventListener('mouseleave', () => this.later());
          p.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const l = this.current && this.current.a; this.close(); if (l) l.focus(); } });
          p.addEventListener('focusout', (e) => { if (!p.contains(e.relatedTarget) && !(this.current && e.relatedTarget === this.current.a)) this.later(); });
          p.querySelectorAll('.ssh-mega__group').forEach((g) => {
            const show = () => {
              p.querySelectorAll('.ssh-mega__group').forEach((x) => x.classList.toggle('is-on', x === g));
              p.querySelectorAll('.ssh-mega__set').forEach((s) => s.classList.toggle('is-on', s.dataset.g === g.dataset.g));
            };
            g.addEventListener('mouseenter', show);
            g.addEventListener('focus', show);
          });
        });
        this.onDoc = (e) => { if (this.current && !this.contains(e.target) && !this.links.some((l) => l.a.contains(e.target))) this.close(); };
        document.addEventListener('pointerdown', this.onDoc);
      }
      disconnectedCallback() { document.removeEventListener('pointerdown', this.onDoc); }
      place() {
        const h = document.querySelector('#header-component');
        if (h) this.style.setProperty('--ssh-mega-top', Math.round(h.getBoundingClientRect().bottom) + 'px');
      }
      open(panel, a) {
        if (!window.matchMedia('(min-width: 990px)').matches) return;
        clearTimeout(this.t);
        this.place();
        if (this.current && this.current.panel === panel) return;
        this.panels.forEach((p) => { if (p !== panel) { p.classList.remove('is-open'); p.hidden = true; } });
        this.links.forEach((l) => l.a.setAttribute('aria-expanded', String(l.panel === panel)));
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-open'));
        this.current = { panel, a };
      }
      later() { clearTimeout(this.t); this.t = setTimeout(() => this.close(), this.delay); }
      close() {
        clearTimeout(this.t);
        if (!this.current) return;
        const p = this.current.panel;
        p.classList.remove('is-open');
        setTimeout(() => { if (!p.classList.contains('is-open')) p.hidden = true; }, 450);
        this.links.forEach((l) => l.a.setAttribute('aria-expanded', 'false'));
        this.current = null;
      }
    });
  }
</script>

{% schema %}
{
  "name": "Soapsister: Mega-Menü",
  "tag": "div",
  "class": "ssh-mega-section",
  "enabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Öffnet sich beim Hovern über einen Hauptmenüpunkt (Desktop). Jeder Block ist eine Kategorie. Blöcke mit demselben Menüpunkt erscheinen zusammen in einem Panel." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Kategorie",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menüpunkt", "info": "Genau wie im Hauptmenü, z. B. Shop", "default": "Shop" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Duschmousse" },
        { "type": "text", "id": "subtitle", "label": "Unterzeile" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product_list", "id": "products", "label": "Produkte", "limit": 4 }
      ]
    }
  ],
  "presets": [{ "name": "Soapsister: Mega-Menü" }]
}
{% endschema %}
