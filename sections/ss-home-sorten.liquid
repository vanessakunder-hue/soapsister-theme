{{ 'ssh-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ssh-trail.js' | asset_url }}" defer></script>
{%- render 'ss-tokens' -%}
<section class="ss-scope ssh-sec ssh-sorten" id="{{ section.settings.anchor | default: section.id }}" style="background:{{ section.settings.bg }};color:{{ section.settings.ink }}">
  {%- render 'ssh-trail', s: section.settings, seed: 0 -%}
  <div class="ssh-sec__in">
    <div class="ssh-sec__head">
      <h2 class="ssh-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ssh-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="ssh-sorten__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign c = block.settings -%}
        <article class="ssh-card" style="--tint:{{ c.tint }};--ink:{{ c.ink }}" {{ block.shopify_attributes }}>
          {%- if c.image != blank -%}
            {{ c.image | image_url: width: 1000 | image_tag: class: 'ssh-card__img', alt: c.image_alt, loading: 'lazy', sizes: '(max-width: 749px) 100vw, 30vw', widths: '400, 600, 800, 1000' }}
          {%- elsif p != blank and p.featured_image -%}
            {{ p.featured_image | image_url: width: 1000 | image_tag: class: 'ssh-card__img', loading: 'lazy', sizes: '(max-width: 749px) 100vw, 30vw' }}
          {%- endif -%}
          <div class="ssh-card__body">
            <div>
              <h3 class="ssh-card__name">{% if p != blank %}<a href="{{ p.url }}">{{ c.name | default: p.title | escape }}</a>{% else %}{{ c.name | escape }}{% endif %}</h3>
              {%- if c.scent != blank -%}<p class="ssh-card__scent">Duschmousse, duftet nach {{ c.scent | escape }}</p>{%- endif -%}
            </div>
            {%- if p != blank -%}
              {%- form 'product', p, class: 'ssh-card__form' -%}
                <fieldset class="ssh-sizes">
                  <legend class="visually-hidden">Größe wählen</legend>
                  {%- for v in p.variants -%}
                    <label class="ssh-size">
                      <input type="radio" name="id" value="{{ v.id }}" {% if v == p.selected_or_first_available_variant %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                      <span class="ssh-size__dot" aria-hidden="true"></span>
                      <span class="ssh-size__t">{{ v.title | escape }}</span>
                      <span class="ssh-size__p">{{ v.price | money }}</span>
                      {%- if v.unit_price_measurement -%}
                        <span class="ssh-size__u">{{ v.unit_price | money }}/{% if v.unit_price_measurement.reference_value != 1 %}{{ v.unit_price_measurement.reference_value }} {% endif %}{{ v.unit_price_measurement.reference_unit }}</span>
                      {%- endif -%}
                      {%- unless v.available -%}<span class="ssh-size__u">ausverkauft</span>{%- endunless -%}
                    </label>
                  {%- endfor -%}
                </fieldset>
                <span class="ssh-note">inkl. MwSt., zzgl. <a href="{{ shop.shipping_policy.url | default: '#' }}" style="text-decoration:underline">Versand</a></span>
                <button type="submit" class="ssh-btn ssh-card__add" {% unless p.available %}disabled{% endunless %}>{% if p.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</button>
              {%- endform -%}
            {%- else -%}
              <p class="ssh-note">Bitte im Editor ein Produkt wählen.</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .ssh-sorten__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .ssh-card{background:var(--tint);border-radius:32px;overflow:hidden;display:flex;flex-direction:column;color:#1D3F51}
  .ssh-card__img{width:100%;height:auto;aspect-ratio:4/3.4;object-fit:cover;object-position:50% 45%;display:block}
  .ssh-card__body{padding:28px 28px 30px;display:flex;flex-direction:column;gap:16px;flex:1}
  .ssh-card__name{margin:0;overflow-wrap:normal;word-break:normal;font-family:var(--ss-display,sans-serif);font-weight:900;font-size:clamp(34px,3.2vw,54px);line-height:.95;text-transform:uppercase;color:var(--ink)}
  .ssh-card__scent{margin:6px 0 0;font-size:18px;line-height:1.35}
  .ssh-card__form{display:flex;flex-direction:column;gap:16px;margin-top:auto}
  .ssh-sizes{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  .ssh-size{position:relative;display:flex;align-items:center;gap:14px;min-height:52px;padding:0 18px;border-radius:16px;cursor:pointer;font-size:18px;background:rgba(255,255,255,.5);border:2px solid transparent;transition:background .2s,border-color .2s}
  .ssh-size input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .ssh-size__dot{width:18px;height:18px;flex:0 0 18px;border-radius:50%;border:2px solid var(--ink);display:grid;place-items:center}
  .ssh-size__dot::after{content:"";width:8px;height:8px;border-radius:50%;background:transparent}
  .ssh-size:has(input:checked){background:#fff;border-color:var(--ink)}
  .ssh-size:has(input:checked) .ssh-size__dot::after{background:var(--ink)}
  .ssh-size:has(input:focus-visible){outline:3px solid var(--ink);outline-offset:2px}
  .ssh-size:has(input:disabled){opacity:.5;cursor:not-allowed}
  .ssh-size__t{font-weight:600;letter-spacing:.06em;min-width:52px}
  .ssh-size__p{font-weight:600}
  .ssh-size__u{margin-left:auto;font-size:15px;opacity:.8}
  .ssh-card__add{background:var(--ink);color:#fff;width:100%}
  .ssh-card__add:disabled{opacity:.5;cursor:not-allowed}
  @media (max-width:989px){.ssh-sorten__grid{grid-template-columns:1fr;max-width:560px}}
  @media (max-width:749px){.ssh-card__name{font-size:44px}.ssh-card__body{padding:22px}}
</style>

{% schema %}
{
  "name": "Soapsister: Sorten",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID", "default": "sorten" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Deine Sorte." },
    { "type": "text", "id": "text", "label": "Text", "default": "Drei Düfte, ein Gefühl: luftig aufgeschlagen, mit Aloe Vera und Mandelöl." },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#EAEDE8" },
    { "type": "color", "id": "ink", "label": "Textfarbe", "default": "#1D3F51" },
    {"type": "header", "content": "Bubble-Pfad"},
    {"type": "checkbox", "id": "show_trail", "label": "Bubble-Pfad zeigen", "default": true},
    {"type": "select", "id": "tone", "label": "Bubble-Farbe", "options": [{"value": "light", "label": "Rosa (heller Hintergrund)"}, {"value": "dark", "label": "Hell (dunkler Hintergrund)"}], "default": "light"},
    {"type": "range", "id": "trail_from", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Pfad-Start oben", "default": 50},
    {"type": "range", "id": "trail_stop", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position Weiter-Bubble", "default": 92},
    {"type": "text", "id": "trail_to", "label": "Pfad-Ende (x,y in %)", "default": "92,100"},
    {"type": "text", "id": "next_label", "label": "Text Weiter-Bubble", "info": "Leer = keine Weiter-Bubble", "default": "Feelgood Set"},
    {"type": "text", "id": "next_link", "label": "Ziel Weiter-Bubble", "info": "Anker der nächsten Section, z. B. #feelgood", "default": "#feelgood"},
    {"type": "color", "id": "stop_ink", "label": "Textfarbe Weiter-Bubble", "default": "#751F65"},
    {"type": "color", "id": "stop_ring", "label": "Ringfarbe Weiter-Bubble", "default": "#751F65"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Sorte",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "name", "label": "Name (leer = Produkttitel)" },
        { "type": "text", "id": "scent", "label": "Duft", "info": "Erscheint als: Duschmousse, duftet nach ..." },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_alt", "label": "Alt-Text Bild" },
        { "type": "color", "id": "tint", "label": "Kartenfarbe", "default": "#F6E2EE" },
        { "type": "color", "id": "ink", "label": "Akzentfarbe", "default": "#751F65" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Soapsister: Sorten" }]
}
{% endschema %}
