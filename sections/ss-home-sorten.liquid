{{ 'ssh-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ssh-trail.js' | asset_url }}" defer></script>
{%- render 'ss-tokens' -%}
<section class="ss-scope ssh-sec ssh-sorten" id="{{ section.settings.anchor | default: section.id }}" style="background:{{ section.settings.bg }};color:{{ section.settings.ink }}">
  {%- render 'ssh-trail', s: section.settings, seed: 0 -%}
  <div class="ssh-sec__in">
    <div class="ssh-sec__head">
      <h2 class="ssh-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ssh-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="ssh-sorten__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign c = block.settings -%}
        {%- assign sel = p.selected_or_first_available_variant -%}
        <ssh-card class="ssh-card" style="--tint:{{ c.tint }};--mix:{{ c.tint_strength }}%;--ink:{{ c.ink }}" {{ block.shopify_attributes }}>
          {%- if c.image != blank -%}
            {{ c.image | image_url: width: 1000 | image_tag: class: 'ssh-card__img', alt: c.image_alt, loading: 'lazy', sizes: '(max-width: 749px) 100vw, 30vw', widths: '400, 600, 800, 1000' }}
          {%- elsif p != blank and p.featured_image -%}
            {{ p.featured_image | image_url: width: 1000 | image_tag: class: 'ssh-card__img', loading: 'lazy', sizes: '(max-width: 749px) 100vw, 30vw' }}
          {%- endif -%}
          <div class="ssh-card__body">
            <div class="ssh-card__top">
              <h3 class="ssh-card__name">{% if p != blank %}<a href="{{ p.url }}">{{ c.name | default: p.title | escape }}</a>{% else %}{{ c.name | escape }}{% endif %}</h3>
              {%- if p != blank -%}
                <div class="ssh-card__price" aria-live="polite">
                  <span class="ssh-card__amount" data-price>{{ sel.price | money }}</span>
                  <span class="ssh-card__unit" data-unit>{% render 'ssh-unit', v: sel %}</span>
                </div>
              {%- endif -%}
            </div>
            {%- if c.scent != blank -%}<p class="ssh-card__scent">Duftet nach {{ c.scent | escape }}</p>{%- endif -%}
            {%- if p != blank -%}
              {%- form 'product', p, class: 'ssh-card__form' -%}
                {%- if p.variants.size > 1 -%}
                  <fieldset class="ssh-seg">
                    <legend class="visually-hidden">Größe wählen</legend>
                    {%- for v in p.variants -%}
                      <label class="ssh-seg__opt">
                        <input type="radio" name="id" value="{{ v.id }}" data-price="{{ v.price | money | escape }}" data-unit="{% render 'ssh-unit', v: v %}" {% if v == sel %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                        <span>{{ v.title | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ sel.id }}">
                {%- endif -%}
                <button type="submit" class="ssh-btn ssh-card__add" {% unless p.available %}disabled{% endunless %}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                  {% if p.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}
                </button>
                <span class="ssh-card__note">inkl. MwSt., zzgl. Versand</span>
              {%- endform -%}
            {%- else -%}
              <p class="ssh-card__note">Bitte im Editor ein Produkt wählen.</p>
            {%- endif -%}
          </div>
        </ssh-card>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .ssh-sorten__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .ssh-card{display:flex;flex-direction:column;padding:10px;border-radius:26px;background:color-mix(in srgb,var(--tint) var(--mix,24%),#FFFFFF);color:var(--ink)}
  .ssh-card__img{width:100%;height:auto;aspect-ratio:4/3.5;object-fit:cover;object-position:50% 45%;border-radius:18px;display:block}
  .ssh-card__body{padding:20px 10px 12px;display:flex;flex-direction:column;gap:6px;flex:1}
  .ssh-card__top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
  .ssh-card__name{margin:0;overflow-wrap:normal;word-break:normal;font-family:var(--ss-display,sans-serif);font-weight:900;font-size:clamp(32px,2.8vw,46px);line-height:.95;text-transform:uppercase;color:var(--ink)}
  .ssh-card__price{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right;flex:0 0 auto;padding-top:4px}
  .ssh-card__amount{font-family:var(--ss-display,sans-serif);font-weight:900;font-size:clamp(22px,1.8vw,28px);line-height:1}
  .ssh-card__unit{font-size:13px;opacity:.75;white-space:nowrap}
  .ssh-card__scent{margin:0;font-size:16px;line-height:1.35;opacity:.85}
  .ssh-card__form{display:flex;flex-direction:column;gap:16px;margin-top:auto;padding-top:18px}
  .ssh-seg{border:0;margin:0;padding:4px;display:flex;gap:4px;border-radius:999px;background:rgba(255,255,255,.6)}
  .ssh-seg__opt{position:relative;flex:1 1 0;display:block}
  .ssh-seg__opt input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
  .ssh-seg__opt span{display:flex;align-items:center;justify-content:center;min-height:44px;border-radius:999px;font-weight:600;font-size:16px;letter-spacing:.08em;color:var(--ink);transition:background .2s,box-shadow .2s}
  .ssh-seg__opt input:checked + span{background:#FFFFFF;box-shadow:0 2px 8px rgba(29,63,81,.14)}
  .ssh-seg__opt input:focus-visible + span{outline:3px solid var(--ink);outline-offset:2px}
  .ssh-seg__opt input:disabled + span{opacity:.4}
  .ssh-card__add{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;background:var(--ink);color:#EAEDE8;padding:16px 24px;font-size:17px}
  .ssh-card__add:disabled{opacity:.5;cursor:not-allowed}
  .ssh-card__note{display:block;text-align:center;font-size:12px;opacity:.7}
  .ssh-card{min-width:0}
  @media (max-width:989px){.ssh-sorten__grid{grid-template-columns:minmax(0,1fr);max-width:520px}}
  @media (max-width:749px){.ssh-card__name{font-size:34px}.ssh-card__amount{font-size:22px}.ssh-card__add{font-size:15px;letter-spacing:.1em;padding:15px 18px}}
</style>

<script>
  if (!customElements.get('ssh-card')) {
    customElements.define('ssh-card', class extends HTMLElement {
      connectedCallback() {
        this.addEventListener('change', (e) => {
          const r = e.target;
          if (!r.matches('input[type="radio"][data-price]')) return;
          const price = this.querySelector('[data-price]:not(input)');
          const unit = this.querySelector('[data-unit]:not(input)');
          if (price) price.textContent = r.dataset.price;
          if (unit) unit.textContent = r.dataset.unit;
        });
      }
    });
  }
</script>

{% schema %}
{
  "name": "Soapsister: Sorten",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID", "default": "sorten" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Deine Sorte." },
    { "type": "text", "id": "text", "label": "Text", "default": "Drei Düfte, ein Gefühl: luftig aufgeschlagen, mit Aloe Vera und Mandelöl." },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#EAEDE8" },
    { "type": "color", "id": "ink", "label": "Textfarbe", "default": "#1D3F51" },
    {"type": "header", "content": "Bubble-Pfad"},
    {"type": "checkbox", "id": "show_trail", "label": "Bubble-Pfad zeigen", "default": true},
    {"type": "select", "id": "tone", "label": "Bubble-Farbe", "options": [{"value": "light", "label": "Rosa (heller Hintergrund)"}, {"value": "dark", "label": "Hell (dunkler Hintergrund)"}], "default": "light"},
    {"type": "range", "id": "trail_from", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Pfad-Start oben", "default": 50},
    {"type": "range", "id": "trail_stop", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position Weiter-Bubble", "default": 92},
    {"type": "text", "id": "trail_to", "label": "Pfad-Ende (x,y in %)", "default": "92,100"},
    {"type": "text", "id": "next_label", "label": "Text Weiter-Bubble", "info": "Leer = keine Weiter-Bubble", "default": "Feelgood Set"},
    {"type": "text", "id": "next_link", "label": "Ziel Weiter-Bubble", "info": "Anker der nächsten Section, z. B. #feelgood", "default": "#feelgood"},
    {"type": "color", "id": "stop_ink", "label": "Textfarbe Weiter-Bubble", "default": "#751F65"},
    {"type": "color", "id": "stop_ring", "label": "Ringfarbe Weiter-Bubble", "default": "#751F65"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Sorte",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "name", "label": "Name (leer = Produkttitel)" },
        { "type": "text", "id": "scent", "label": "Duft", "info": "Erscheint als: Duftet nach ..." },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_alt", "label": "Alt-Text Bild" },
        { "type": "color", "id": "tint", "label": "Farbe der Sorte (CI)", "default": "#E08FBC" },
        { "type": "range", "id": "tint_strength", "min": 8, "max": 100, "step": 2, "unit": "%", "label": "Stärke der Kartenfarbe", "default": 24 },
        { "type": "color", "id": "ink", "label": "Akzentfarbe", "default": "#751F65" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Soapsister: Sorten" }]
}
{% endschema %}
