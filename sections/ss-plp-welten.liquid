{%- comment -%}
  Soapsister Kategorieseite nach Design "Welten A: Baender ueber die volle Breite" (25.11.2026).
  Pro Sorte ein Band: Stimmungsbild ueber die volle Breite, darunter die freigestellte Dose (gross, ueberlappt das Band),
  Name, Duft, Preis mit Grundpreis und Warenkorb. Der Groessen-Umschalter oben gilt fuer alle Sorten.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
{%- assign st = section.settings -%}
{%- assign first = section.blocks.first.settings.product | default: collection.products.first -%}
{%- assign size_opt = first.options_with_values.first -%}
<section class="ss-scope ssh-plp" id="SshPlp-{{ section.id }}">
  <div class="ssh-plp__intro">
    <div class="ssh-plp__head">
      <h1 class="ssh-plp__h1">{{ st.heading | default: collection.title | escape }}</h1>
      {%- if st.text != blank -%}<p class="ssh-plp__lead">{{ st.text | escape }}</p>{%- endif -%}
    </div>
    {%- if size_opt and size_opt.values.size > 1 -%}
      <fieldset class="ssh-plp__sizes">
        <legend class="visually-hidden">Größe für alle Sorten</legend><span class="ssh-plp__sizes-l" aria-hidden="true">Größe</span>
        <div class="ssh-plp__seg">
          {%- for v in size_opt.values -%}
            <label><input type="radio" name="ssh-size-{{ section.id }}" value="{{ v | escape }}" {% if forloop.first %}checked{% endif %}><span>{{ v | escape }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endif -%}
  </div>

  <div class="ssh-plp__bands">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings -%}
      {%- assign p = c.product -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      {%- assign v0 = p.variants.first -%}
      {%- capture vmap -%}{ {%- for v in p.variants -%}"{{ v.option1 | escape }}":{"id":{{ v.id }},"price":"{{ v.price | money | escape }}","unit":"{% render 'ssh-unit', v: v %}","ok":{{ v.available }}}{% unless forloop.last %},{% endunless %}{%- endfor -%} }{%- endcapture -%}
      <article class="ssh-band{% cycle ' ssh-band--a', ' ssh-band--b' %}" style="--ink:{{ c.ink }};--btn:{{ c.button }}" data-variants="{{ vmap | strip | escape }}" {{ block.shopify_attributes }}>
        <a class="ssh-band__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- if c.band != blank -%}
            {{ c.band | image_url: width: 2880 | image_tag: class: 'ssh-band__bg', alt: '', loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2880' }}
          {%- endif -%}
        </a>
        <div class="ssh-band__body">
          <a class="ssh-band__jar" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if c.jar != blank -%}
              {{ c.jar | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 749px) 62vw, 28vw', widths: '400, 600, 900' }}
            {%- elsif p.featured_image -%}
              {{ p.featured_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 749px) 62vw, 28vw' }}
            {%- endif -%}
          </a>
          <div class="ssh-band__text">
            <h2 class="ssh-band__name"><a href="{{ p.url }}">{{ c.name | default: p.title | escape }}</a></h2>
            {%- if c.scent != blank -%}<p class="ssh-band__scent">Duftet nach {{ c.scent | escape }}</p>{%- endif -%}
            <p class="ssh-band__price" aria-live="polite"><span data-price>{{ v0.price | money }}</span><span class="ssh-band__unit" data-unit>{% render 'ssh-unit', v: v0 %}</span></p>
            <form action="{{ routes.cart_add_url }}" method="post" class="ssh-band__form">
              <input type="hidden" name="id" value="{{ v0.id }}" data-id>
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="ssh-band__add" {% unless v0.available %}disabled{% endunless %} data-add>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                <span data-label>{% if v0.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
              </button>
            </form>
            <span class="ssh-band__note">inkl. MwSt., zzgl. Versand</span>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if st.set_text != blank -%}
    {%- assign setp = st.set_product -%}
    <div class="ssh-plp__set">
      <span>{{ st.set_text | escape }}{% if setp != blank %} für {{ setp.price | money }}{% endif %}.</span>
      <a href="{{ st.set_link | default: '/collections/sets' }}">{{ st.set_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  {%- endif -%}
</section>

<style>
  .ssh-plp{background:var(--color-background,#F1F1E9);color:#1D1D1B;padding-bottom:96px}
  .ssh-plp a{color:inherit;text-decoration:none}
  .ssh-plp__intro{padding:64px 7.4% 72px;display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap}
  .ssh-plp__head{display:flex;flex-direction:column;gap:14px}
  .ssh-plp__h1{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(64px,7vw,104px);line-height:.9;color:#1D1D1B}
  .ssh-plp__lead{margin:0;font-size:20px;line-height:1.45;max-width:44ch}
  .ssh-plp__sizes{border:0;margin:0;padding:0;display:flex;align-items:center;gap:14px}
  .ssh-plp__sizes-l{font-size:15px;opacity:.75}
  .ssh-plp__seg{display:flex;gap:4px;padding:5px;border-radius:999px;background:#FFFFFF}
  .ssh-plp__seg label{position:relative;display:block}
  .ssh-plp__seg input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
  .ssh-plp__seg span{display:flex;align-items:center;justify-content:center;min-width:84px;min-height:44px;padding:0 14px;border-radius:999px;font-weight:600;font-size:17px;letter-spacing:.1em;text-transform:uppercase;color:#1D1D1B;transition:background .2s,color .2s}
  .ssh-plp__seg input:checked + span{background:#751F65;color:#F1F1E9}
  .ssh-plp__seg input:focus-visible + span{outline:3px solid #751F65;outline-offset:2px}
  .ssh-plp__bands{display:flex;flex-direction:column;gap:120px}
  .ssh-band{position:relative}
  .ssh-band__media{position:relative;display:block;height:clamp(260px,30vw,440px);overflow:hidden}
  .ssh-band__media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(241,241,233,0) 50%,rgba(241,241,233,.55) 100%);pointer-events:none}
  .ssh-band__bg{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s ease}
  .ssh-band:hover .ssh-band__bg{transform:scale(1.04)}
  .ssh-band__body{position:relative;padding:44px 7.4% 0;display:flex;min-height:200px}
  .ssh-band--b .ssh-band__body{justify-content:flex-end}
  .ssh-band__jar{position:absolute;top:calc(clamp(260px,30vw,440px) * -.55);width:clamp(280px,30vw,440px);display:block;z-index:2;transition:transform .5s cubic-bezier(.3,1.5,.5,1)}
  .ssh-band--a .ssh-band__jar{right:10%}
  .ssh-band--b .ssh-band__jar{left:10%}
  .ssh-band__jar img{width:100%;height:auto;display:block;filter:drop-shadow(0 26px 24px rgba(29,29,27,.28)) drop-shadow(0 6px 8px rgba(29,29,27,.18))}
  .ssh-band__jar::after{content:"";position:absolute;left:12%;right:12%;bottom:-18px;height:26px;border-radius:50%;background:radial-gradient(closest-side,rgba(29,29,27,.22),rgba(29,29,27,0));z-index:-1}
  .ssh-band:hover .ssh-band__jar{transform:translateY(-12px)}
  .ssh-band__text{display:flex;flex-direction:column;align-items:flex-start;gap:10px;max-width:420px}
  .ssh-band__name{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(48px,4.6vw,68px);line-height:.92;color:var(--ink)}
  .ssh-band__scent{margin:0;font-size:19px}
  .ssh-band__price{margin:4px 0 6px;display:flex;flex-direction:column;gap:2px}
  .ssh-band__price [data-price]{font-weight:600;font-size:24px;color:var(--ink)}
  .ssh-band__unit{font-size:14px;opacity:.75}
  .ssh-band__add{display:flex;align-items:center;gap:10px;min-height:50px;padding:0 26px;border-radius:999px;border:2px solid var(--btn);background:transparent;color:var(--btn);cursor:pointer;font-family:inherit;font-weight:600;font-size:16px;letter-spacing:.14em;text-transform:uppercase;transition:background .2s,color .2s}
  .ssh-band__add:hover,.ssh-band__add:focus-visible{background:var(--btn);color:#F1F1E9}
  .ssh-band__add:focus-visible{outline:3px solid var(--btn);outline-offset:3px}
  .ssh-band__add:disabled{opacity:.5;cursor:not-allowed}
  .ssh-band__note{font-size:12px;opacity:.7}
  .ssh-band__name a:focus-visible{outline:3px solid var(--ink);outline-offset:4px}
  .ssh-plp__set{margin:104px 7.4% 0;padding:28px 0;border-top:2px solid rgba(29,29,27,.15);border-bottom:2px solid rgba(29,29,27,.15);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;font-size:20px}
  .ssh-plp__set a{display:flex;align-items:center;gap:8px;font-weight:600;font-size:17px;letter-spacing:.12em;text-transform:uppercase;color:#751F65}
  @media (max-width:749px){
    .ssh-plp__intro{padding:40px 20px 48px}
    .ssh-plp__head{min-width:0;max-width:100%}
    .ssh-plp__h1{font-size:clamp(44px,13vw,64px);overflow-wrap:normal}
    .ssh-plp__lead{font-size:18px}
    .ssh-plp__sizes-l{display:none}
    .ssh-plp__bands{gap:72px}
    .ssh-band__media{height:220px}
    .ssh-band__body,.ssh-band--b .ssh-band__body{flex-direction:column;align-items:center;padding:0 20px;justify-content:flex-start}
    .ssh-band__jar,.ssh-band--a .ssh-band__jar,.ssh-band--b .ssh-band__jar{position:relative;top:auto;left:auto;right:auto;width:62vw;margin-top:-34vw}
    .ssh-band__text{align-items:center;text-align:center;margin-top:18px}
    .ssh-plp__set{margin:72px 20px 0;font-size:18px}
  }
  @media (prefers-reduced-motion:reduce){.ssh-band__bg,.ssh-band__jar,.ssh-band__add{transition:none}}
</style>

<script>
  (function () {
    var root = document.getElementById('SshPlp-{{ section.id }}');
    if (!root) return;
    root.addEventListener('change', function (e) {
      if (!e.target.matches('input[type="radio"][name^="ssh-size-"]')) return;
      var val = e.target.value;
      root.querySelectorAll('.ssh-band[data-variants]').forEach(function (b) {
        var map;
        try { map = JSON.parse(b.dataset.variants); } catch (err) { return; }
        var v = map[val];
        if (!v) return;
        b.querySelector('[data-id]').value = v.id;
        b.querySelector('[data-price]').textContent = v.price;
        b.querySelector('[data-unit]').textContent = v.unit;
        var btn = b.querySelector('[data-add]');
        btn.disabled = !v.ok;
        btn.querySelector('[data-label]').textContent = v.ok ? 'In den Warenkorb' : 'Ausverkauft';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Soapsister: Duft-Welten",
  "tag": "div",
  "class": "ssh-plp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (leer = Name der Kollektion)", "default": "Duschmousse." },
    { "type": "text", "id": "text", "label": "Text", "default": "Drei Düfte, luftig aufgeschlagen, mit Aloe Vera und Mandelöl." },
    { "type": "header", "content": "Hinweis auf die Sets" },
    { "type": "text", "id": "set_text", "label": "Text", "default": "Lieber im Set? Mousse, Netzschwamm und Badeente" },
    { "type": "product", "id": "set_product", "label": "Set-Produkt für den Preis" },
    { "type": "text", "id": "set_label", "label": "Link-Text", "default": "Zu den Feelgood Sets" },
    { "type": "url", "id": "set_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "band",
      "name": "Sorte",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "name", "label": "Name (leer = Produkttitel)" },
        { "type": "text", "id": "scent", "label": "Duft", "info": "Erscheint als: Duftet nach ..." },
        { "type": "image_picker", "id": "band", "label": "Bild für das Band (Querformat)" },
        { "type": "image_picker", "id": "jar", "label": "Freigestellte Dose" },
        { "type": "color", "id": "ink", "label": "Farbe Name und Preis", "default": "#751F65" },
        { "type": "color", "id": "button", "label": "Farbe Button", "default": "#751F65" }
      ]
    }
  ],
  "presets": [{ "name": "Soapsister: Duft-Welten" }]
}
{% endschema %}
