  .ssh-set__acc summary span{font-size:26px;color:var(--btn);transition:transform .25s}
  .ssh-set__acc details[open] summary span{transform:rotate(45deg)}
  .ssh-set__acc summary:focus-visible{outline:3px solid var(--btn);outline-offset:2px}
  .ssh-set__acc-body{padding-bottom:16px;font-size:17px;line-height:1.55}
  .ssh-set__acc-body p{margin:0 0 10px}
  .ssh-set__acc-body a{text-decoration:underline;text-underline-offset:3px}
  .ssh-set__h2{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:72px;line-height:.92}
  .ssh-set__ritual{margin-top:120px;background:var(--rbg,#751F65);transition:background .4s,color .4s;color:var(--rtxt,#FFFFFF);padding:96px 7.4%}
  .ssh-set__ritual-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:48px}
  .ssh-set__ritual-head .ssh-set__h2 span{color:var(--racc,#E08FBC)}
  .ssh-set__ritual-head p{margin:0;font-size:20px;line-height:1.45;max-width:34ch}
  .ssh-set__rlist{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}
  .ssh-set__rlist li{display:flex;flex-direction:column;gap:16px}
  .ssh-set__rtile{height:260px;border-radius:28px;background:color-mix(in srgb,var(--rtxt,#FFFFFF) 10%,transparent);display:grid;place-items:center}
  .ssh-set__rimg{display:grid;place-items:center;width:100%;height:100%}
  .ssh-set__rimg img{max-height:210px;max-width:78%;width:auto;height:auto;display:block;filter:drop-shadow(0 18px 18px rgba(0,0,0,.25))}
  .ssh-set__rlist h3{margin:0;font-weight:600;font-size:28px;letter-spacing:.08em;text-transform:uppercase;color:var(--rtxt,#FFFFFF)}
  .ssh-set__rlist p{margin:0;font-size:19px;line-height:1.45;max-width:30ch}
  .ssh-set__gift{padding:110px 7.4% 120px;display:flex;gap:64px;flex-wrap:wrap;align-items:center}
  .ssh-set__gift-media{flex:1 1 480px;min-width:0}
  .ssh-set__gift-media span{display:block}
  .ssh-set__gift-img{width:100%;height:460px;object-fit:cover;object-position:50% 35%;border-radius:32px;display:block}
  .ssh-set__gift-text{flex:1 1 380px;min-width:0;display:flex;flex-direction:column;gap:18px;color:#751F65}
  .ssh-set__gift-text p{margin:0;font-size:20px;line-height:1.5;color:#4A1240;max-width:34ch}
  .ssh-set__ghost{align-self:flex-start;display:flex;align-items:center;gap:10px;border:2px solid #751F65;border-radius:999px;min-height:48px;padding:0 24px;font-weight:600;font-size:16px;letter-spacing:.14em;text-transform:uppercase;transition:background .2s,color .2s}
  .ssh-set .ssh-set__ghost{color:#751F65}
  .ssh-set .ssh-set__ghost:hover,.ssh-set .ssh-set__ghost:focus-visible{background:#751F65;color:#FFFFFF}
  .ssh-set__ghost:focus-visible{outline:3px solid #751F65;outline-offset:3px}
  @media (max-width:989px){.ssh-set__main{gap:40px}.ssh-set__rlist{grid-template-columns:minmax(0,1fr);gap:32px}}
  @media (max-width:749px){
    .ssh-set__crumbs{padding:8px 20px 0}
    .ssh-set__main{padding:20px 20px 0}
    .ssh-set__gallery,.ssh-set__info{flex-basis:100%}
    .ssh-set__stage{border-radius:24px}
    .ssh-set__thumbs{gap:8px}
    .ssh-set__th{border-radius:12px}
    .ssh-set__card{padding:28px 20px 24px;border-radius:24px;gap:18px}
    .ssh-set__h1{font-size:clamp(42px,11vw,54px)}
    .ssh-set__sub{font-size:18px}
    .ssh-set__amount{font-size:38px}
    .ssh-set__flavs{gap:8px}
    .ssh-set__flav-t{font-size:11px;letter-spacing:0}
    .ssh-set__dot{width:28px;height:28px}
    .ssh-set__items li{gap:10px;padding:8px 12px 8px 8px}
    .ssh-set__iname{font-size:16px}
    .ssh-set__iprice{font-size:14px}
    .ssh-set__add{font-size:14px;letter-spacing:.03em;gap:8px;padding:0 12px}
    .ssh-set__add svg{display:none}
    .ssh-set__qty button{width:42px}
    .ssh-set__qty input{width:28px}
    .ssh-set__h2{font-size:48px}
    .ssh-set__ritual{margin-top:80px;padding:64px 20px}
    .ssh-set__rtile{height:220px}
    .ssh-set__gift{padding:72px 20px 80px;gap:32px}
    .ssh-set__gift-media{flex-basis:100%}
    .ssh-set__gift-img{height:340px}
  }
  @media (prefers-reduced-motion:reduce){.ssh-set__stage,.ssh-set__card,.ssh-set__iimg,.ssh-set__add,.ssh-set__acc summary span{transition:none}}
</style>

<script>
  if (!customElements.get('ssh-set')) {
    customElements.define('ssh-set', class extends HTMLElement {
      connectedCallback() {
        this.main = this.querySelector('.ssh-set__img');
        this.fit();
        if (document.fonts) document.fonts.ready.then(() => this.fit());
        window.addEventListener('resize', () => this.fit(), { passive: true });
        this.querySelectorAll('.ssh-set__th').forEach((t) => t.addEventListener('click', () => this.show(t)));
        const qi = this.querySelector('[data-qty-input]');
        this.querySelectorAll('[data-qty]').forEach((b) => b.addEventListener('click', () => {
          qi.value = Math.max(1, (parseInt(qi.value, 10) || 1) + Number(b.dataset.qty));
        }));
        this.addEventListener('change', (e) => { if (e.target.name === 'ssh-set-flavor') this.flavor(e.target); });
        const top = this.querySelector('[data-totop]');
        if (top) top.addEventListener('click', (e) => { e.preventDefault(); const card = this.querySelector('.ssh-set__card'); card.scrollIntoView({ behavior: 'smooth', block: 'start' }); const f = this.querySelector('input[name="ssh-set-flavor"]:checked'); if (f) f.focus({ preventScroll: true }); });
      }
      fit() {
        const h = this.querySelector('.ssh-set__h1');
        if (!h) return;
        h.style.fontSize = '';
        const over = () => Array.from(h.children).some((s) => s.scrollWidth > h.clientWidth + 1);
        let s = parseFloat(getComputedStyle(h).fontSize), guard = 40;
        while (over() && s > 32 && guard--) { s -= 2; h.style.fontSize = s + 'px'; }
      }
      show(t) {
        if (!this.main) return;
        this.main.srcset = t.dataset.srcset; this.main.src = t.dataset.src; this.main.alt = t.dataset.alt;
        this.querySelectorAll('.ssh-set__th').forEach((x) => x.setAttribute('aria-pressed', x === t ? 'true' : 'false'));
      }
      flavor(r) {
        const k = r.value;
        this.style.setProperty('--ink', r.dataset.ink);
        this.style.setProperty('--btn', r.dataset.btn);
        this.style.setProperty('--tint', r.dataset.tint);
        this.style.setProperty('--rbg', r.dataset.rbg);
        this.style.setProperty('--racc', r.dataset.racc);
        this.style.setProperty('--rtxt', r.dataset.rtxt);
        this.querySelectorAll('[data-fl]').forEach((el) => { el.hidden = el.dataset.fl !== k; });
        this.querySelector('[data-name]').textContent = r.dataset.name;
        this.fit();
        this.querySelector('[data-id]').value = r.dataset.id;
        const ok = r.dataset.ok === 'true', btn = this.querySelector('[data-add]');
        btn.disabled = !ok;
        btn.querySelector('[data-label]').textContent = ok ? 'Set in den Warenkorb' : 'Ausverkauft';
        const th = this.querySelector('.ssh-set__th[data-fl="' + k + '"]');
        if (th) this.show(th);
        if (r.dataset.url) history.replaceState(history.state, '', r.dataset.url);
        if (r.dataset.title) document.title = document.title.replace(/^[^|–-]+/, r.dataset.title + ' ');
      }
    });
  }
</script>
<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';
  const root = document.getElementById('SshSet-{{ section.id }}');
  const form = root && root.querySelector('form.ssh-set__form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-add]'), label = btn.querySelector('[data-label]'), err = form.querySelector('[data-error]');
      if (btn.disabled) return;
      const idle = label.textContent;
      btn.disabled = true; err.hidden = true; label.textContent = 'Wird hinzugefügt';
      const fd = new FormData(form);
      fd.delete('ssh-set-flavor');
      const ids = Array.from(document.querySelectorAll('cart-items-component')).map((el) => el.dataset.sectionId).filter(Boolean);
      if (ids.length) fd.append('sections', ids.join(','));
      const qty = Number(fd.get('quantity')) || 1;
      let deferred = null;
      try {
        deferred = CartLinesUpdateEvent.createPromise();
        form.dispatchEvent(new CartLinesUpdateEvent({ action: 'add', context: 'product', lines: [{ merchandiseId: String(fd.get('id')), quantity: qty }], promise: deferred.promise }));
      } catch (x) { deferred = null; }
      const routes = (window.Theme && window.Theme.routes) || {};
      let added = false;
      try {
        const res = await fetch(routes.cart_add_url || '/cart/add', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/javascript' } });
        const data = await res.json();
        added = !data.status;
        const cart = await fetch((routes.cart_url || '/cart') + '.json', { headers: { Accept: 'application/json' } }).then((r) => r.json());
        if (data.status) {
          err.textContent = data.description || data.message || 'Das hat leider nicht geklappt.'; err.hidden = false;
          form.dispatchEvent(new CartErrorEvent({ error: data.message || 'Add to cart failed', code: 'INVALID', detail: { description: data.description } }));
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: true, items: cart.items, source: 'ssh-set', sourceId: form.id, itemCount: qty } });
          label.textContent = idle;
        } else {
          if (deferred) deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { didError: false, items: cart.items, source: 'ssh-set', sourceId: form.id, itemCount: qty, sections: data.sections } });
          if (!deferred) { location.href = routes.cart_url || '/cart'; return; }
          if (window.sshBubbleFly) window.sshBubbleFly(e.submitter ? e.submitter : btn, root.dataset.bubble, getComputedStyle(root).getPropertyValue('--btn'));
          label.textContent = 'Hinzugefügt';
          setTimeout(() => { label.textContent = idle; }, 1800);
        }
      } catch (x) {
        if (deferred && deferred.reject) deferred.reject(x);
        if (added) { location.href = routes.cart_url || '/cart'; } else { form.submit(); }
        return;
      }
      btn.disabled = false;
    });
  }
</script>

