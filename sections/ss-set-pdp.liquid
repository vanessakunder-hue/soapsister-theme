{%- comment -%}
  Soapsister Produktseite Feelgood Set nach Design "PDP: Feelgood Set" (25.11.2026).
  Jede Sorte ist ein eigenes Set-Produkt. Pro Sorte ein Block (Set, Mousse, Schwamm, Ente, Farben).
  Der Umschalter "Deine Sorte" wechselt auf der Seite zwischen den Sets: Farben, Name, Bild, Inhalt,
  Warenkorb und Adresse. Ohne JavaScript fuehren die Sorten als Links zum jeweiligen Set.
{%- endcomment -%}
{%- render 'ss-tokens' -%}
<script src="{{ 'ssh-bubble-fly.js' | asset_url }}" defer></script>
{%- assign st = section.settings -%}
{%- assign cur = section.blocks.first -%}
{%- for b in section.blocks -%}{%- if b.settings.set_product.id == product.id -%}{%- assign cur = b -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- assign c = cur.settings -%}
{%- assign sel = product.selected_or_first_available_variant -%}
{%- assign fid = 'SshSetForm-' | append: section.id -%}
<ssh-set class="ss-scope ssh-set" id="SshSet-{{ section.id }}" data-bubble="{{ 'soapsister-seifenblase-rosa.png' | file_url }}" style="--ink:{{ c.ink }};--btn:{{ c.button }};--tint:{{ c.tint }};--rbg:{{ c.ritual_bg | default: '#751F65' }};--racc:{{ c.ritual_accent | default: '#E08FBC' }};--rtxt:{{ c.ritual_text_color | default: '#FFFFFF' }}">
  <nav class="ssh-set__crumbs" aria-label="Brotkrümel"><a href="{{ st.crumb_link | default: '/collections/sets' }}">{{ st.crumb_label | escape }}</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ st.title | escape }}</span></nav>

  <section class="ssh-set__main">
    <div class="ssh-set__gallery">
      <div class="ssh-set__stage">
        {%- assign first_img = c.set_product.featured_image -%}
        {%- if first_img -%}{{ first_img | image_url: width: 1600 | image_tag: class: 'ssh-set__img', alt: c.set_product.title, sizes: '(max-width: 989px) 100vw, 50vw', widths: '600, 900, 1200, 1600', fetchpriority: 'high' }}{%- endif -%}
      </div>
      <div class="ssh-set__thumbs">
        {%- for b in section.blocks -%}
          {%- assign im = b.settings.set_product.featured_image -%}
          {%- if im == blank -%}{%- continue -%}{%- endif -%}
          <button type="button" class="ssh-set__th" data-fl="{{ b.id }}" aria-label="Bild 1 zeigen" aria-pressed="true" data-src="{{ im | image_url: width: 1600 }}" data-srcset="{{ im | image_url: width: 600 }} 600w, {{ im | image_url: width: 900 }} 900w, {{ im | image_url: width: 1200 }} 1200w, {{ im | image_url: width: 1600 }} 1600w" data-alt="{{ b.settings.set_product.title | escape }}" {% unless b.id == cur.id %}hidden{% endunless %}>{{ im | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', sizes: '120px', widths: '120, 240' }}</button>
        {%- endfor -%}
        {%- for b in section.blocks -%}
          {%- for i in (2..4) -%}
            {%- assign key = 'gallery_' | append: i -%}
            {%- assign im = b.settings[key] -%}
            {%- if im == blank -%}{%- continue -%}{%- endif -%}
            <button type="button" class="ssh-set__th" data-fl="{{ b.id }}" aria-label="Bild {{ i }} zeigen" aria-pressed="false" data-src="{{ im | image_url: width: 1600 }}" data-srcset="{{ im | image_url: width: 600 }} 600w, {{ im | image_url: width: 900 }} 900w, {{ im | image_url: width: 1200 }} 1200w, {{ im | image_url: width: 1600 }} 1600w" data-alt="{{ im.alt | escape }}" {% unless b.id == cur.id %}hidden{% endunless %}>{{ im | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', sizes: '120px', widths: '120, 240' }}</button>
          {%- endfor -%}
        {%- endfor -%}
        {%- for i in (2..5) -%}
          {%- assign key = 'gallery_' | append: i -%}
          {%- assign im = st[key] -%}
          {%- if im == blank -%}{%- continue -%}{%- endif -%}
          <button type="button" class="ssh-set__th" aria-label="Bild {{ i }} zeigen" aria-pressed="false" data-src="{{ im | image_url: width: 1600 }}" data-srcset="{{ im | image_url: width: 600 }} 600w, {{ im | image_url: width: 900 }} 900w, {{ im | image_url: width: 1200 }} 1200w, {{ im | image_url: width: 1600 }} 1600w" data-alt="{{ im.alt | escape }}">{{ im | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', sizes: '120px', widths: '120, 240' }}</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="ssh-set__info">
      <div class="ssh-set__card">
        <div>
          <h1 class="ssh-set__h1"><span>{{ st.title | escape }}</span> <span data-name>{{ c.name | escape }}</span></h1>
          {%- if st.sub != blank -%}<p class="ssh-set__sub">{{ st.sub | escape }}</p>{%- endif -%}
        </div>
        {%- if st.usps != blank -%}
          {%- assign usps = st.usps | split: '|' -%}
          <ul class="ssh-set__usps">
            {%- for u in usps -%}
              <li><span class="ssh-set__chk" aria-hidden="true" style="--rot:{{ forloop.index0 | times: 90 }}deg"><img src="{{ 'soapsister-seifenblase-rosa.png' | file_url }}" alt="" width="28" height="28" loading="lazy"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>{{ u | strip | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- for b in section.blocks -%}
          {%- assign bs = b.settings -%}
          {%- assign sp = bs.set_product -%}
          {%- if sp == blank -%}{%- continue -%}{%- endif -%}
          {%- assign sum = 0 -%}
          {%- if bs.mousse != blank -%}{%- assign sum = sum | plus: bs.mousse.variants.first.price -%}{%- endif -%}
          {%- if bs.sponge != blank -%}{%- assign sum = sum | plus: bs.sponge.price -%}{%- endif -%}
          {%- if bs.duck != blank -%}{%- assign sum = sum | plus: bs.duck.price -%}{%- endif -%}
          {%- assign save = sum | minus: sp.price -%}
          <div class="ssh-set__pricerow" data-fl="{{ b.id }}" {% unless b.id == cur.id %}hidden{% endunless %}>
            <div class="ssh-set__price"><span class="ssh-set__amount">{{ sp.price | money }}</span>{%- if save > 0 -%}<span class="ssh-set__was">statt <s>{{ sum | money }}</s></span><span class="ssh-set__save">Spar {{ save | money }}</span>{%- endif -%}</div>
            {%- if st.nl_label != blank -%}<a class="ssh-set__nl" href="{{ st.nl_link | default: '#newsletter' }}"><span>{{ st.nl_badge | escape }}</span>{{ st.nl_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
          </div>
        {%- endfor -%}
        <span class="ssh-set__tax">inkl. MwSt., zzgl. Versand</span>

        <hr class="ssh-set__rule">

        {%- form 'product', product, id: fid, class: 'ssh-set__form' -%}
          <input type="hidden" name="id" value="{{ sel.id }}" data-id>
          {%- if section.blocks.size > 1 -%}
            <fieldset class="ssh-set__field">
              <legend class="ssh-set__label">{{ st.flavor_label | escape }}</legend>
              <div class="ssh-set__flavs">
                {%- for b in section.blocks -%}
                  {%- assign sp = b.settings.set_product -%}
                  {%- if sp == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign sv = sp.selected_or_first_available_variant -%}
                  <label class="ssh-set__flav">
                    <input type="radio" name="ssh-set-flavor" value="{{ b.id }}" data-id="{{ sv.id }}" data-ok="{{ sv.available }}" data-url="{{ sp.url }}" data-name="{{ b.settings.name | escape }}" data-ink="{{ b.settings.ink }}" data-btn="{{ b.settings.button }}" data-tint="{{ b.settings.tint }}" data-rbg="{{ b.settings.ritual_bg | default: '#751F65' }}" data-racc="{{ b.settings.ritual_accent | default: '#E08FBC' }}" data-rtxt="{{ b.settings.ritual_text_color | default: '#FFFFFF' }}" data-title="{{ sp.title | escape }}" {% if b.id == cur.id %}checked{% endif %}>
                    <span class="ssh-set__flav-box"><span class="ssh-set__dot" style="background:{{ b.settings.dot }}" aria-hidden="true"></span><span class="ssh-set__flav-t">{{ b.settings.name | escape }}</span></span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
            <hr class="ssh-set__rule">
          {%- endif -%}

          <div class="ssh-set__field">
            <span class="ssh-set__label">{{ st.items_label | escape }}</span>
            {%- for b in section.blocks -%}
              {%- assign bs = b.settings -%}
              <ul class="ssh-set__items" data-fl="{{ b.id }}" {% unless b.id == cur.id %}hidden{% endunless %}>
                {%- if bs.mousse != blank -%}
                  <li><span class="ssh-set__iimg">{%- if bs.jar != blank -%}{{ bs.jar | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}</span><a class="ssh-set__iname" href="{{ bs.mousse.url }}">{{ bs.mousse.title | escape }} {{ bs.mousse.variants.first.title | escape }}</a><span class="ssh-set__iprice">einzeln {{ bs.mousse.variants.first.price | money }}</span></li>
                {%- endif -%}
                {%- if bs.sponge != blank -%}
                  <li><span class="ssh-set__iimg">{%- if bs.sponge.featured_image -%}{{ bs.sponge.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}</span><span class="ssh-set__iname">{{ bs.sponge.title | escape }}</span><span class="ssh-set__iprice">einzeln {{ bs.sponge.price | money }}</span></li>
                {%- endif -%}
                {%- if bs.duck != blank -%}
                  <li><span class="ssh-set__iimg">{%- if bs.duck.featured_image -%}{{ bs.duck.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}</span><span class="ssh-set__iname">{{ bs.duck.title | escape }}</span><span class="ssh-set__iprice">einzeln {{ bs.duck.price | money }}</span></li>
                {%- endif -%}
              </ul>
            {%- endfor -%}
          </div>

          <div class="ssh-set__buy">
            <div class="ssh-set__qty">
              <button type="button" data-qty="-1" aria-label="Weniger">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Menge" data-qty-input>
              <button type="button" data-qty="1" aria-label="Mehr">+</button>
            </div>
            <button type="submit" class="ssh-set__add" data-add {% unless sel.available %}disabled{% endunless %}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
              <span data-label>{% if sel.available %}Set in den Warenkorb{% else %}Ausverkauft{% endif %}</span>
            </button>
          </div>
          <p class="ssh-set__error" role="alert" hidden data-error></p>
        {%- endform -%}
      </div>

      <div class="ssh-set__acc">
        {%- if st.usage != blank -%}
          <details><summary>Anwendung<span aria-hidden="true">+</span></summary><div class="ssh-set__acc-body">{{ st.usage }}</div></details>
        {%- endif -%}
        {%- if st.ingredients != blank -%}
          <details><summary>Inhaltsstoffe<span aria-hidden="true">+</span></summary><div class="ssh-set__acc-body">{{ st.ingredients }}
            {%- for b in section.blocks -%}{%- if b.settings.mousse != blank -%}<p data-fl="{{ b.id }}" {% unless b.id == cur.id %}hidden{% endunless %}><a href="{{ b.settings.mousse.url }}">Zur Produktseite {{ b.settings.mousse.title | escape }}</a></p>{%- endif -%}{%- endfor -%}
          </div></details>
        {%- endif -%}
        {%- if st.shipping != blank -%}
          <details><summary>Versand<span aria-hidden="true">+</span></summary><div class="ssh-set__acc-body">{{ st.shipping }}</div></details>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if st.ritual_heading != blank -%}
    <section class="ssh-set__ritual" aria-labelledby="SshSetRitual-{{ section.id }}">
      <div class="ssh-set__ritual-head">
        <h2 class="ssh-set__h2" id="SshSetRitual-{{ section.id }}">{{ st.ritual_heading | escape }}{% if st.ritual_heading2 != blank %}<br><span>{{ st.ritual_heading2 | escape }}</span>{% endif %}</h2>
        {%- if st.ritual_text != blank -%}<p>{{ st.ritual_text | escape }}</p>{%- endif -%}
      </div>
      <ul class="ssh-set__rlist">
        {%- for i in (1..3) -%}
          {%- assign tk = 'r' | append: i | append: '_title' -%}
          {%- assign xk = 'r' | append: i | append: '_text' -%}
          <li>
            <div class="ssh-set__rtile">
              {%- for b in section.blocks -%}
                {%- assign bs = b.settings -%}
                {%- liquid
                  case i
                    when 1
                      assign rim = bs.jar
                    when 2
                      assign rim = bs.sponge.featured_image
                    else
                      assign rim = bs.duck.featured_image
                  endcase
                -%}
                {%- if rim != blank -%}<span class="ssh-set__rimg" data-fl="{{ b.id }}" {% unless b.id == cur.id %}hidden{% endunless %}>{{ rim | image_url: width: 600 | image_tag: alt: '', loading: 'lazy', sizes: '300px', widths: '300, 450, 600' }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
            <h3>{{ st[tk] | escape }}</h3>
            <p>{{ st[xk] | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- if st.gift_heading != blank -%}
    <section class="ssh-set__gift" aria-labelledby="SshSetGift-{{ section.id }}">
      <div class="ssh-set__gift-media">
        {%- for b in section.blocks -%}
          {%- assign gim = b.settings.gift_image | default: st.gift_image -%}
          {%- if gim != blank -%}<span data-fl="{{ b.id }}" {% unless b.id == cur.id %}hidden{% endunless %}>{{ gim | image_url: width: 1400 | image_tag: class: 'ssh-set__gift-img', alt: gim.alt, loading: 'lazy', sizes: '(max-width: 749px) 100vw, 50vw', widths: '600, 900, 1200, 1400' }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="ssh-set__gift-text">
        <h2 class="ssh-set__h2" id="SshSetGift-{{ section.id }}">{{ st.gift_heading | escape }}{% if st.gift_heading2 != blank %}<br>{{ st.gift_heading2 | escape }}{% endif %}</h2>
        {%- if st.gift_text != blank -%}<p>{{ st.gift_text | escape }}</p>{%- endif -%}
        {%- if st.gift_label != blank -%}<a class="ssh-set__ghost" href="#SshSet-{{ section.id }}" data-totop>{{ st.gift_label | escape }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
      </div>
    </section>
  {%- endif -%}
</ssh-set>

<script type="application/ld+json">{{ product | structured_data }}</script>

<style>
  .ssh-set{display:block;background:var(--color-background,#F1F1E9);color:#1D1D1B}
  .ssh-set a{color:inherit;text-decoration:none}
  .ssh-set [hidden]{display:none !important}
  .ssh-set__crumbs{padding:8px 7.4% 0;font-size:15px;letter-spacing:.06em;opacity:.75}
  .ssh-set__crumbs a:hover{text-decoration:underline;text-underline-offset:3px}
  .ssh-set__main{padding:28px 7.4% 0;display:flex;gap:72px;flex-wrap:wrap;align-items:flex-start}
  .ssh-set__gallery{flex:1.15 1 560px;min-width:0;display:flex;flex-direction:column;gap:14px}
  .ssh-set__stage{aspect-ratio:1/1;border-radius:32px;overflow:hidden;background:var(--tint);transition:background .4s}
  .ssh-set__img{width:100%;height:100%;object-fit:cover;display:block}
  .ssh-set__thumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
  .ssh-set__th{padding:0;border:0;border-radius:18px;overflow:hidden;aspect-ratio:1;cursor:pointer;opacity:.65;outline:3px solid transparent;outline-offset:3px;background:var(--tint);transition:opacity .2s,outline-color .2s}
  .ssh-set__th img{width:100%;height:100%;object-fit:cover;display:block}
  .ssh-set__th:hover{opacity:1}
  .ssh-set__th[aria-pressed="true"],.ssh-set__th:focus-visible{opacity:1;outline-color:var(--ink)}
  .ssh-set__info{flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:24px}
  .ssh-set__card{background:var(--tint);border-radius:32px;padding:40px 36px 32px;display:flex;flex-direction:column;gap:20px;transition:background .4s}
  .ssh-set__h1{margin:0;font-family:var(--ss-display,sans-serif);font-weight:900;text-transform:uppercase;font-size:clamp(52px,4.4vw,70px);line-height:1;letter-spacing:.015em;color:var(--ink);overflow-wrap:normal}
  .ssh-set__h1 span{display:block;white-space:nowrap}
  .ssh-set__sub{margin:10px 0 0;font-size:20px;line-height:1.4}
  .ssh-set__usps{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 18px}
  .ssh-set__usps li{display:flex;align-items:center;gap:6px;font-weight:600;font-size:15px;letter-spacing:.04em;color:var(--ink)}
  .ssh-set__chk{position:relative;width:28px;height:28px;display:grid;place-items:center}
  .ssh-set__chk img{position:absolute;inset:0;width:100%;height:100%;rotate:var(--rot)}
  .ssh-set__chk svg{position:relative}
  .ssh-set__pricerow{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
  .ssh-set__price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;color:var(--ink)}
  .ssh-set__amount{font-weight:600;font-size:46px;line-height:1}
  .ssh-set__was{font-size:18px}
  .ssh-set__save{align-self:center;background:var(--btn);color:#FFFFFF;border-radius:999px;padding:5px 12px;font-weight:600;font-size:14px;letter-spacing:.1em;text-transform:uppercase}
  .ssh-set__nl{display:flex;align-items:center;gap:6px;font-size:15px}
  .ssh-set .ssh-set__nl{color:var(--ink)}
  .ssh-set__nl span{background:#FFFFFF;border-radius:999px;padding:4px 10px;font-weight:600;font-size:14px}
  .ssh-set__nl:hover{text-decoration:underline;text-underline-offset:3px}
  .ssh-set__tax{font-size:14px;margin-top:-10px;opacity:.8}
  .ssh-set__rule{border:0;height:2px;margin:4px 0;background:color-mix(in srgb,var(--ink) 12%,transparent)}
  .ssh-set__form{display:flex;flex-direction:column;gap:20px;margin:0}
  .ssh-set__field{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;min-width:0}
  .ssh-set__label{padding:0;font-weight:600;font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}
  .ssh-set__flavs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .ssh-set__flav{position:relative;display:block}
  .ssh-set__flav input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer;z-index:1}
  .ssh-set__flav-box{display:flex;flex-direction:column;align-items:center;gap:8px;padding:14px 4px 12px;min-width:0;border-radius:20px;background:rgba(255,255,255,.5);border:2px solid transparent;transition:background .2s,border-color .2s}
  .ssh-set__flav input:checked + .ssh-set__flav-box{background:#FFFFFF;border-color:var(--btn)}
  .ssh-set__flav input:focus-visible + .ssh-set__flav-box{outline:3px solid var(--btn);outline-offset:2px}
  .ssh-set__dot{width:34px;height:34px;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(29,29,27,.12)}
  .ssh-set__flav-t{max-width:100%;font-weight:600;font-size:14px;letter-spacing:.04em;text-transform:uppercase}
  .ssh-set__items{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  .ssh-set__items li{display:flex;align-items:center;gap:14px;background:#FFFFFF;border-radius:18px;padding:8px 18px 8px 8px}
  .ssh-set__iimg{width:56px;height:56px;flex:0 0 56px;border-radius:14px;background:var(--tint);display:grid;place-items:center;transition:background .4s}
  .ssh-set__iimg img{max-width:46px;max-height:46px;width:auto;height:auto;display:block}
  .ssh-set__iname{flex:1 1 auto;min-width:0;font-size:18px}
  .ssh-set a.ssh-set__iname:hover{text-decoration:underline;text-underline-offset:3px}
  .ssh-set__iprice{font-size:16px;opacity:.7;white-space:nowrap}
  .ssh-set__buy{display:flex;gap:12px;align-items:stretch;margin-top:6px}
  .ssh-set__qty{display:flex;align-items:center;border-radius:999px;background:#FFFFFF}
  .ssh-set__qty button{width:52px;height:60px;border:0;background:transparent;cursor:pointer;font-size:26px;color:var(--btn);border-radius:999px}
  .ssh-set__qty button:focus-visible{outline:3px solid var(--btn);outline-offset:-3px}
  .ssh-set__qty input{width:34px;border:0;background:transparent;text-align:center;font:inherit;font-weight:600;font-size:20px;color:#1D1D1B;-moz-appearance:textfield;appearance:textfield}
  .ssh-set__qty input::-webkit-outer-spin-button,.ssh-set__qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .ssh-set__add{flex:1 1 auto;display:flex;align-items:center;justify-content:center;gap:12px;min-height:60px;border:0;border-radius:999px;background:var(--btn);color:#FFFFFF;cursor:pointer;font-family:inherit;font-weight:600;font-size:18px;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;box-shadow:0 14px 30px color-mix(in srgb,var(--btn) 25%,transparent);transition:filter .2s,background .4s}
  .ssh-set__add:hover{filter:brightness(1.15)}
  .ssh-set__add:focus-visible{outline:3px solid var(--btn);outline-offset:3px}
  .ssh-set__add:disabled{opacity:.5;cursor:not-allowed;filter:none}
  .ssh-set__error{margin:0;padding:12px 16px;border-radius:14px;background:#FFFFFF;color:#9B1C1C;font-size:16px}
  .ssh-set__acc{padding:0 8px;border-top:2px solid rgba(29,29,27,.15)}
  .ssh-set__acc details{border-bottom:2px solid rgba(29,29,27,.15)}
