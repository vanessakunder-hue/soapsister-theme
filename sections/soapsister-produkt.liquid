{%- comment -%}
  Soapsister Produktseite für die Duschmousse.
  Jede Sorte ist ein Block (Produkt, Farben, Duft, Inhaltsstoffe). Der Block, dessen Produkt
  zur aktuellen Seite passt, liefert Farben und Texte; alle Blöcke zusammen bilden die Sortenwahl.
{%- endcomment -%}

{%- liquid
  assign current = blank
  for block in section.blocks
    if block.settings.product != blank and block.settings.product.id == product.id
      assign current = block
    endif
  endfor

  assign accent = section.settings.default_accent
  assign tint = section.settings.default_tint
  if current != blank
    assign accent = current.settings.accent_color
    assign tint = current.settings.tint_color
  endif

  assign selected = product.selected_or_first_available_variant
  assign images = product.media | where: 'media_type', 'image'
-%}

<div class="section section--full-width">
  <soapsister-produkt
    class="soapsister-produkt"
    style="
      --produkt-accent: {{ accent }};
      --produkt-tint: {{ tint }};
      --produkt-radius: {{ section.settings.corner_radius }}px;
      padding-block-start: {{ section.settings.padding-block-start }}px;
      padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    <div class="soapsister-produkt__gallery" aria-roledescription="Bildergalerie" aria-label="Bilder von {{ product.title | escape }}">
      <div class="soapsister-produkt__stage">
        {%- if images.size > 1 -%}
          <div class="soapsister-produkt__thumbs">
            {%- for media in images -%}
              <button
                type="button"
                class="soapsister-produkt__thumb"
                data-thumb="{{ forloop.index0 }}"
                aria-label="Bild {{ forloop.index }} anzeigen"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if images.size > 0 -%}
          {%- for media in images -%}
            {%- liquid
              assign loading = 'lazy'
              if forloop.first
                assign loading = 'eager'
              endif
            -%}
            <div
              class="soapsister-produkt__media"
              data-slide
              aria-roledescription="Bild"
              aria-label="{{ forloop.index }} von {{ images.size }}"
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              {{
                media.preview_image
                | image_url: width: 1600
                | image_tag:
                  loading: loading,
                  widths: '400, 600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 45vw, 100vw',
                  alt: media.alt
                  | default: product.title,
                  class: 'soapsister-produkt__image'
              }}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="soapsister-produkt__media" data-slide>
            {{ 'product-1' | placeholder_svg_tag: 'soapsister-produkt__image' }}
          </div>
        {%- endif -%}

        {%- if images.size > 1 -%}
          <button type="button" class="soapsister-produkt__arrow soapsister-produkt__arrow--prev" data-prev aria-label="Vorheriges Bild">&larr;</button>
          <button type="button" class="soapsister-produkt__arrow soapsister-produkt__arrow--next" data-next aria-label="Nächstes Bild">&rarr;</button>
          <span class="soapsister-produkt__counter" aria-live="polite"><span data-current>1</span> / {{ images.size }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="soapsister-produkt__info">
      {%- if section.settings.kicker != blank -%}
        <p class="soapsister-produkt__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h1 class="soapsister-produkt__title">
        {%- if current != blank and current.settings.label != blank -%}
          {{ current.settings.label }}
        {%- else -%}
          {{ product.title }}
        {%- endif -%}
      </h1>
      {%- if current != blank and current.settings.scent != blank -%}
        <p class="soapsister-produkt__scent">{{ current.settings.scent }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 1 -%}
        <nav class="soapsister-produkt__sorts" aria-label="Sorte wählen">
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              <a
                href="{{ block.settings.product.url }}"
                class="soapsister-produkt__sort"
                style="--sort-dot: {{ block.settings.dot_color }}; --sort-accent: {{ block.settings.accent_color }};"
                {% if block.settings.product.id == product.id %}
                  aria-current="page"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <span class="soapsister-produkt__dot" aria-hidden="true"></span>
                {{ block.settings.label | default: block.settings.product.title }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="soapsister-produkt__price" ref="price">
        <strong data-price>{{ selected.price | money }}</strong>
        <span data-unit>
          {%- if selected.unit_price_measurement -%}
            ({{ selected.unit_price | unit_price_with_measurement: selected.unit_price_measurement }})
          {%- endif -%}
        </span>
      </div>
      {%- if section.settings.tax_note != blank -%}
        <p class="soapsister-produkt__tax">
          {{ section.settings.tax_note }}
          {%- if shop.shipping_policy.body != blank %}
            <a href="{{ shop.shipping_policy.url }}">{{ section.settings.shipping_label }}</a>
          {%- else %}
            {{ section.settings.shipping_label }}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- form 'product', product, class: 'soapsister-produkt__form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ selected.id }}">
        {%- else -%}
          <fieldset class="soapsister-produkt__sizes">
            <legend class="soapsister-produkt__legend">{{ product.options.first }}</legend>
            {%- for variant in product.variants -%}
              <label class="soapsister-produkt__size">
                <input
                  type="radio"
                  name="id"
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-unit="{% if variant.unit_price_measurement %}({{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement | escape }}){% endif %}"
                  {% if variant == selected %}
                    checked
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                <span class="soapsister-produkt__size-name">{{ variant.title }}</span>
                <span>
                  {{- variant.price | money -}}
                  {%- unless variant.available %} · ausverkauft{% endunless -%}
                </span>
                {%- if section.settings.recommended_variant != blank and variant.title == section.settings.recommended_variant -%}
                  <span class="soapsister-produkt__badge">{{ section.settings.recommended_label }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}

        <button
          type="submit"
          name="add"
          class="soapsister-produkt__button"
          {% unless product.available %}
            disabled
          {% endunless %}
        >
          {%- if product.available -%}
            {{ section.settings.button_label }}
          {%- else -%}
            Ausverkauft
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if current != blank and current.settings.set_product != blank -%}
        {%- liquid
          assign set_product = current.settings.set_product
          assign set_variant = set_product.selected_or_first_available_variant
          assign mousse_variant = product.variants.first
          for variant in product.variants
            if variant.title == section.settings.recommended_variant
              assign mousse_variant = variant
            endif
          endfor
          assign set_sum = mousse_variant.price
          for i in (1..2)
            assign key = 'addon_' | append: i
            assign addon = current.settings[key]
            if addon != blank
              assign set_sum = set_sum | plus: addon.selected_or_first_available_variant.price
            endif
          endfor
        -%}
        <div class="soapsister-produkt__set">
          <p class="soapsister-produkt__legend">{{ section.settings.addons_heading }}</p>
          <div class="soapsister-produkt__set-items">
            <span class="soapsister-produkt__set-item">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
              <span>{{ product.title }} {{ mousse_variant.title }}</span>
            </span>
            {%- for i in (1..2) -%}
              {%- assign key = 'addon_' | append: i -%}
              {%- assign addon = current.settings[key] -%}
              {%- if addon != blank -%}
                <span class="soapsister-produkt__plus" aria-hidden="true">+</span>
                <span class="soapsister-produkt__set-item">
                  {%- if addon.featured_image -%}
                    {{ addon.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                  <span>{{ addon.title }}</span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="soapsister-produkt__set-prices">
            {%- if set_sum > set_variant.price -%}
              <s class="soapsister-produkt__set-old">{{ set_sum | money }}</s>
            {%- endif -%}
            <strong class="soapsister-produkt__set-new">{{ set_variant.price | money }}</strong>
            {%- if set_sum > set_variant.price -%}
              <span class="soapsister-produkt__saving">Du sparst {{ set_sum | minus: set_variant.price | money }}</span>
            {%- endif -%}
          </div>
          {%- form 'product', set_product, class: 'soapsister-produkt__set-form' -%}
            <input type="hidden" name="id" value="{{ set_variant.id }}">
            <button
              type="submit"
              name="add"
              class="soapsister-produkt__set-button"
              {% unless set_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if set_variant.available -%}
                {{ section.settings.set_button_label }}
              {%- else -%}
                Ausverkauft
              {%- endif -%}
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.check_1 != blank or section.settings.check_2 != blank -%}
        <ul class="soapsister-produkt__checks">
          {%- if section.settings.check_1 != blank -%}
            <li>{{ section.settings.check_1 }}</li>
          {%- endif -%}
          {%- if section.settings.check_2 != blank -%}
            <li>{{ section.settings.check_2 }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <div class="soapsister-produkt__details">
        {%- if section.settings.usage != blank -%}
          <details class="soapsister-produkt__detail">
            <summary>Anwendung</summary>
            <div class="soapsister-produkt__detail-body">{{ section.settings.usage }}</div>
          </details>
        {%- endif -%}
        {%- if current != blank and current.settings.inci != blank -%}
          <details class="soapsister-produkt__detail">
            <summary>Inhaltsstoffe</summary>
            <div class="soapsister-produkt__detail-body">{{ current.settings.inci }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.safety != blank -%}
          <details class="soapsister-produkt__detail">
            <summary>Produktsicherheit</summary>
            <div class="soapsister-produkt__detail-body">{{ section.settings.safety }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.shipping != blank -%}
          <details class="soapsister-produkt__detail">
            <summary>Versand und Rückgabe</summary>
            <div class="soapsister-produkt__detail-body">{{ section.settings.shipping }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </soapsister-produkt>
</div>

{% stylesheet %}
  .soapsister-produkt {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-inline: 16px;
  }

  @media screen and (min-width: 990px) {
    .soapsister-produkt {
      grid-template-columns: 1.35fr 1fr;
      gap: 56px;
      align-items: start;
      padding-inline: 16px max(40px, calc((100vw - 1400px) / 2 + 40px));
    }

    .soapsister-produkt__info {
      align-self: start;
    }
  }

  .soapsister-produkt__gallery {
    display: grid;
  }

  .soapsister-produkt__stage {
    position: relative;
  }

  .soapsister-produkt__thumbs {
    position: absolute;
    top: 16px;
    inset-inline-start: 16px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media screen and (max-width: 749px) {
    .soapsister-produkt__thumbs {
      top: auto;
      bottom: 48px;
      left: 50%;
      flex-direction: row;
      transform: translateX(-50%);
    }
  }

  .soapsister-produkt__thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    background: rgb(255 255 255 / 0.5);
    border: 1.5px solid rgb(255 255 255 / 0.8);
    border-radius: calc(var(--produkt-radius) / 2);
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .soapsister-produkt__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .soapsister-produkt__thumb:hover,
  .soapsister-produkt__thumb[aria-current='true'] {
    opacity: 1;
  }

  .soapsister-produkt__thumb[aria-current='true'] {
    border-color: var(--produkt-accent);
  }

  .soapsister-produkt__thumb:focus-visible {
    outline: 2px solid var(--produkt-accent);
    outline-offset: 2px;
  }

  .soapsister-produkt__media {
    overflow: hidden;
    background: var(--produkt-tint);
    border-radius: var(--produkt-radius);
  }

  .soapsister-produkt__media[hidden] {
    display: none;
  }

  .soapsister-produkt__arrow {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 44px;
    font: inherit;
    font-size: 1.25rem;
    color: var(--produkt-accent);
    background: rgb(255 255 255 / 0.8);
    border: 1.5px solid transparent;
    border-radius: 50%;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .soapsister-produkt__arrow--prev {
    inset-inline-start: 16px;
  }

  .soapsister-produkt__arrow--next {
    inset-inline-end: 16px;
  }

  @media screen and (max-width: 749px) {
    .soapsister-produkt__arrow--prev {
      inset-inline-start: 16px;
    }
  }

  .soapsister-produkt__arrow:hover {
    background: rgb(255 255 255);
    border-color: var(--produkt-accent);
  }

  .soapsister-produkt__arrow:focus-visible {
    outline: 2px solid var(--produkt-accent);
    outline-offset: 2px;
  }

  .soapsister-produkt__counter {
    position: absolute;
    bottom: 12px;
    left: 50%;
    padding: 2px 10px;
    font-size: 0.8125rem;
    background: rgb(255 255 255 / 0.8);
    border-radius: 999px;
    transform: translateX(-50%);
  }

  .soapsister-produkt__badge {
    position: absolute;
    top: -10px;
    inset-inline-end: 12px;
    padding: 2px 10px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: var(--produkt-accent);
    border-radius: 999px;
  }

  .soapsister-produkt__addons {
    display: grid;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    border: 0;
  }

  .soapsister-produkt__addon {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    background: rgb(255 255 255 / 0.6);
    border: 1.5px solid transparent;
    border-radius: calc(var(--produkt-radius) / 1.5);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .soapsister-produkt__addon:has(input:checked) {
    background: rgb(255 255 255);
    border-color: var(--produkt-accent);
  }

  .soapsister-produkt__addon:has(input:focus-visible) {
    outline: 2px solid var(--produkt-accent);
    outline-offset: 2px;
  }

  .soapsister-produkt__addon input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .soapsister-produkt__check {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--produkt-accent);
    border-radius: 50%;
  }

  .soapsister-produkt__addon:has(input:checked) .soapsister-produkt__check {
    background: var(--produkt-accent);
  }

  .soapsister-produkt__addon:has(input:checked) .soapsister-produkt__check::after {
    content: '✓';
    font-size: 0.75rem;
    color: #fff;
  }

  .soapsister-produkt__addon-images {
    display: flex;
    flex: 0 0 auto;
  }

  .soapsister-produkt__addon-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .soapsister-produkt__addon-image + .soapsister-produkt__addon-image {
    margin-inline-start: -10px;
  }

  .soapsister-produkt__addon-price {
    margin-inline-start: auto;
    font-weight: 700;
    white-space: nowrap;
  }

  .soapsister-produkt__set {
    display: grid;
    gap: 12px;
    padding: 16px 18px;
    background: rgb(255 255 255 / 0.6);
    border-radius: calc(var(--produkt-radius) / 1.5);
  }

  .soapsister-produkt__set .soapsister-produkt__legend {
    margin: 0;
    font-weight: 700;
  }

  .soapsister-produkt__set-items {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }

  .soapsister-produkt__set-item {
    display: grid;
    flex: 1 1 0;
    gap: 4px;
    justify-items: center;
    font-size: 0.75rem;
    text-align: center;
  }

  .soapsister-produkt__set-item img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    background: var(--produkt-tint);
    border-radius: 50%;
  }

  .soapsister-produkt__plus {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--produkt-accent);
  }

  .soapsister-produkt__set-prices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: baseline;
  }

  .soapsister-produkt__set-old {
    opacity: 0.7;
  }

  .soapsister-produkt__set-new {
    font-size: 1.5rem;
    color: var(--produkt-accent);
  }

  .soapsister-produkt__saving {
    padding: 2px 10px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #fff;
    background: var(--produkt-accent);
    border-radius: 999px;
  }

  .soapsister-produkt__set-form {
    display: grid;
  }

  .soapsister-produkt__set-button {
    min-height: 48px;
    padding: 0 24px;
    font: inherit;
    font-weight: 700;
    color: var(--produkt-accent);
    background: rgb(255 255 255);
    border: 1.5px solid var(--produkt-accent);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .soapsister-produkt__set-button:hover {
    color: #fff;
    background: var(--produkt-accent);
  }

  .soapsister-produkt__set-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .soapsister-produkt__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .soapsister-produkt__image {
      aspect-ratio: 1;
    }
  }

  .soapsister-produkt__info {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .soapsister-produkt__kicker,
  .soapsister-produkt__scent,
  .soapsister-produkt__tax {
    margin: 0;
  }

  .soapsister-produkt__kicker {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .soapsister-produkt__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: var(--produkt-accent);
  }

  .soapsister-produkt__scent {
    font-size: 1.125rem;
  }

  .soapsister-produkt__sorts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .soapsister-produkt__sort {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    color: inherit;
    text-decoration: none;
    background: rgb(255 255 255 / 0.6);
    border: 1.5px solid transparent;
    border-radius: 999px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .soapsister-produkt__sort:hover {
    background: rgb(255 255 255);
  }

  .soapsister-produkt__sort[aria-current='page'] {
    font-weight: 700;
    background: rgb(255 255 255);
    border-color: var(--sort-accent);
  }

  .soapsister-produkt__dot {
    width: 12px;
    height: 12px;
    background: var(--sort-dot);
    border-radius: 50%;
  }

  .soapsister-produkt__price {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .soapsister-produkt__price strong {
    font-size: 1.75rem;
  }

  .soapsister-produkt__tax {
    font-size: 0.8125rem;
  }

  .soapsister-produkt__tax a {
    color: inherit;
  }

  .soapsister-produkt__form {
    display: grid;
    gap: 12px;
  }

  .soapsister-produkt__sizes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .soapsister-produkt__legend {
    margin-bottom: 8px;
    font-size: 0.875rem;
  }

  .soapsister-produkt__size {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px 18px;
    background: rgb(255 255 255 / 0.6);
    border: 1.5px solid transparent;
    border-radius: calc(var(--produkt-radius) / 1.5);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .soapsister-produkt__size:has(input:checked) {
    background: rgb(255 255 255);
    border-color: var(--produkt-accent);
  }

  .soapsister-produkt__size:has(input:focus-visible) {
    outline: 2px solid var(--produkt-accent);
    outline-offset: 2px;
  }

  .soapsister-produkt__size:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .soapsister-produkt__size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .soapsister-produkt__size-name {
    font-weight: 700;
  }

  .soapsister-produkt__size > span {
    white-space: nowrap;
  }

  .soapsister-produkt__button {
    min-height: 56px;
    padding: 0 24px;
    font: inherit;
    font-weight: 700;
    color: #fff;
    background: var(--produkt-accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .soapsister-produkt__button:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .soapsister-produkt__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .soapsister-produkt__checks {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soapsister-produkt__checks li::before {
    content: '✓';
    margin-inline-end: 8px;
    font-weight: 700;
    color: var(--produkt-accent);
  }

  .soapsister-produkt__details {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .soapsister-produkt__detail {
    padding: 0 18px;
    background: rgb(255 255 255 / 0.6);
    border-radius: calc(var(--produkt-radius) / 1.5);
  }

  .soapsister-produkt__detail summary {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .soapsister-produkt__detail summary::-webkit-details-marker {
    display: none;
  }

  .soapsister-produkt__detail summary::after {
    content: '+';
    color: var(--produkt-accent);
  }

  .soapsister-produkt__detail[open] summary::after {
    content: '−';
  }

  .soapsister-produkt__detail-body {
    padding-bottom: 16px;
  }
{% endstylesheet %}

{% javascript %}
  class SoapsisterProdukt extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('.soapsister-produkt__size input').forEach((input) => {
        input.addEventListener('change', () => this.update(input));
      });

      this.slides = Array.from(this.querySelectorAll('[data-slide]'));
      this.index = 0;
      this.querySelector('[data-prev]')?.addEventListener('click', () => this.show(this.index - 1));
      this.querySelector('[data-next]')?.addEventListener('click', () => this.show(this.index + 1));
      this.thumbs = Array.from(this.querySelectorAll('[data-thumb]'));
      this.thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => this.show(Number(thumb.dataset.thumb)));
      });
    }

    show(index) {
      if (this.slides.length === 0) return;
      this.index = (index + this.slides.length) % this.slides.length;
      this.slides.forEach((slide, i) => {
        slide.hidden = i !== this.index;
      });
      const current = this.querySelector('[data-current]');
      if (current) current.textContent = String(this.index + 1);
      this.thumbs?.forEach((thumb, i) => {
        if (i === this.index) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
    }

    update(input) {
      const price = this.querySelector('[data-price]');
      const unit = this.querySelector('[data-unit]');
      if (price) price.textContent = input.dataset.price;
      if (unit) unit.textContent = input.dataset.unit;
    }
  }

  if (!customElements.get('soapsister-produkt')) {
    customElements.define('soapsister-produkt', SoapsisterProdukt);
  }
{% endjavascript %}

